    "duotone-line": "纯线性双色（#19191A + #C00000，无半透明面性填充）",
    "duotone-surface": "线性 + 面性点缀（#19191A + #C00000 + fill-opacity:0.3 半透明面块）",
    "line-mono-lg": "大尺寸纯黑线性（36px/48px，仅 #19191A，无红点缀无面块）",
