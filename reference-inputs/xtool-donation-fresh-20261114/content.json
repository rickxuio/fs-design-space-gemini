      "id": "project-1",
      "items": [
        {
          "objectId": "project-1",
          "title": "Super Fab Lab Kerala",
          "description": "Super Fab Lab Kerala integrated the xTool F1 Ultra into two practical learning modules: stencil-making for student design projects and laser soldering for fast, clean electronic assembly. These activities highlight how xTool helps learners bridge the gap between theory and real-world engineering.",
          "image": "https://cdn.shopify.com/s/files/1/0467/7985/9095/files/mk-1_25forthemakers_us_pc_frame1329132191_1066-6245_ae630a49-6ac6-4e12-8cda-e8f258993de1.webp?v=1764752216",
          "link": {
