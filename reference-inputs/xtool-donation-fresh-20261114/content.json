    {
      "id": "stories",
      "items": [
        {
          "objectId": "story-0",
          "title": "@ISA International Education Group, China",
          "image": "https://cdn.shopify.com/s/files/1/0467/7985/9095/files/mk-1_25forthemakers_us_pc_frame1329132148_1066-5746.webp?v=1764750434",
          "quote": "“Our old laser was failing constantly, and with 2,000+ students, we just couldn’t keep up. The xTool P2S came at the perfect time and solved a real problem for us.” --- Chris, a teacher"
        },
        {
          "objectId": "story-1",
          "title": "@Hack Club Daydream Yaounde, Cameroon",
          "image": "https://cdn.shopify.com/s/files/1/0467/7985/9095/files/mk-1_25forthemakers_us_pc_frame1329132149_1066-5768.webp?v=1764750434",
          "quote": "“As a nonprofit, we’re always working with limited funds and only a handful of machines. Once the xTool F1 showed up, it immediately became the star of our hackathon.” --- Samuel, the Event Manager"
        },
        {
          "objectId": "story-2",
          "title": "@Suncoast Science Center, US",
          "image": "https://cdn.shopify.com/s/files/1/0467/7985/9095/files/mk-1_25forthemakers_us_pc_frame1329132150_1066-5780.webp?v=1764750434",
          "quote": "\"Our old MIG welding setup was limited and our students always wanted to build more. Now the MetalFab has changed everything! Kids are thrilled!” --- Eric, the Manager"
        },
        {
          "objectId": "story-3",
          "title": "@BrightStone, US",
          "image": "https://cdn.shopify.com/s/files/1/0467/7985/9095/files/mk-1_25forthemakers_us_pc_frame1329132151_1066-5805.webp?v=1764750434",
          "quote": "“For our students, creativity is more than an activity — it’s a pathway to confidence and independence. Thanks to xTool, that pathway is now wide open.” --- Randy, the Chief of Staff"
        },
        {
          "objectId": "story-4",
          "title": "@Mississippi Aquarium, US",
          "image": "https://cdn.shopify.com/s/files/1/0467/7985/9095/files/mk-1_25forthemakers_us_pc_frame1329132152_1066-5816_484d4081-d3f2-4f9f-a312-9c4721b87453.webp?v=1764913513",
          "quote": "“Last week, we made an awesome axolotl for kids’ birthday lessons. But the best part is using the P2 to build training stations for our turtles and other little critters!” --- Maria, the Event Manager"
        },
        {
          "objectId": "story-5",
          "title": "@Xerocraft Makerspace, US",
          "image": "https://cdn.shopify.com/s/files/1/0467/7985/9095/files/mk-1_25forthemakers_us_pc_frame1329132153_1066-5823.webp?v=1764750434",
          "quote": "“Our community is full of scientists, engineers, artists, tradespeople, and hobbyists. Now they all have found different ways to express their creativity through the xTool.” --- Don, the Laser Shop Manager"
        }
      ]
    },
