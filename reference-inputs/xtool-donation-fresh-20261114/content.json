          }
        }
      ]
    },
    {
      "id": "mission",
      "items": [
        {
          "objectId": "mission",
          "title": "Our Mission",
          "description": "xTool was born from the Maker Movement. So we give back— by dedicating 1% of our profits to creators everywhere. Even today, far too many students, kids, and underserved communities still don’t have access to maker tools. We’re here to change that. We bring creativity to the places that need it most.",
          "image": "https://cdn.shopify.com/s/files/1/0467/7985/9095/files/mk-1_25forthemakers_us_pc_frame1329132144_1066-5285_bb408dd2-add4-4258-a098-321987cfb8d4.webp?v=1764834781"
        }
      ]
    },
    {
      "id": "testimonials",
      "items": [
        {
          "objectId": "testimonial-0",
          "title": "Make:",
          "description": "“We're excited to see xTool's innovative tools reaching more educators and makers. xTool is helping more people bring their ideas to life and inspiring the next generation of inventors.”",
          "image": "https://cdn.shopify.com/s/files/1/0467/7985/9095/files/mk-xtoolfablab_us_pc_pc-make_300-1941_ab6da789-1fb1-4b24-8321-c0b28723e043.webp?v=1756987958"
        },
        {
          "objectId": "testimonial-1",
          "title": "fabfoundation",
          "description": "“Together with xTool and the global Fab Lab network, we're unlocking creativity, expanding opportunity, and building a more inclusive and sustainable future for all.”",
          "image": "https://cdn.shopify.com/s/files/1/0467/7985/9095/files/mk-xtoolfablab_us_pc_pc-foundation_300-1921_a159032e-e0f6-4495-be41-a416112b33e5.webp?v=1756987958"
        }
      ]
    },
    {
      "id": "impact",
      "items": [
        {
          "objectId": "impact",
          "title": "Our Impact So Far",
          "description": "Since our launch on September 8, 2025, 1% for the Makers has reached thousands of learners and creators in just 3 months — and the impact continues to grow.",
