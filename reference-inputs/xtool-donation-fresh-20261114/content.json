          "objectId": "hero",
          "title": "1% for the Makers",
          "description": "xTool donates 1% of its net profits to provide maker tools to schools, nonprofits, and makerspaces worldwide.",
          "image": "https://cdn.shopify.com/s/files/1/0467/7985/9095/files/mk-1_25forthemakers_us_pc_pc-banner_1066-4118_0dc297e5-d826-40ad-89d3-b24d8c18f741.webp?v=1764749175",
