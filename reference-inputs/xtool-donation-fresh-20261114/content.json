    {
      "id": "faq",
      "items": [
        {
          "objectId": "faq-0",
          "title": "Who is eligible to apply for the 1% for the Makers program?",
          "description": "We welcome applications from registered nonprofit organizations, official Fab Labs, accredited educational institutions (including K-12 schools, districts, and universities), public libraries, and museums."
        },
        {
          "objectId": "faq-1",
          "title": "Is this program available internationally?",
          "description": "Yes. 1% for the Makers is a global program. We encourage eligible organizations from around the world to apply."
        },
        {
          "objectId": "faq-2",
          "title": "What equipment is included in the donation?",
          "description": "Donations are tailored to the needs and plans of the recipient organization. They typically consist of one of our flagship laser cutters or engravers, such as the xTool P2S or S1."
        },
        {
          "objectId": "faq-3",
          "title": "Is there any cost to our organization?",
          "description": "The equipment and access to our educational resources are provided free of charge to selected recipients. Organizations are responsible for providing a suitable space, any necessary site preparations, and ongoing operational costs."
        },
        {
          "objectId": "faq-4",
          "title": "What kind of support is provided after we receive the equipment?",
          "description": "Beyond the hardware, you gain access to our comprehensive support ecosystem. This includes technical support from the xTool team, a library of tutorials and projects, professional development webinars, and an invitation to our educator community to connect with peers."
        },
        {
          "objectId": "faq-5",
          "title": "How are recipients selected?",
          "description": "Our review committee evaluates applications based on demonstrated need, the strength and clarity of the proposed vision, the potential for community impact, and the organization's capacity to successfully implement their program."
        },
        {
          "objectId": "faq-6",
          "title": "What is the application deadline?",
          "description": "We accept and review applications on a rolling basis throughout the year. There is no fixed deadline, allowing organizations to apply when they are ready."
        },
        {
          "objectId": "faq-7",
          "title": "How does this relate to the Pledge 1% movement?",
          "description": "We are deeply inspired by the Pledge 1% movement and its mission to embed social impact into the DNA of all businesses. We have adopted its spirit by dedicating our resources—including our products, time, and network—to empower the global maker community."
        }
      ]
    }
