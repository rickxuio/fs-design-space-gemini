      "structure": "ds-dropdown > ds-dropdown__trigger + ds-dropdown__panel > ds-dropdown__list > ds-dropdown__item",
      "cssClass": "ds-dropdown",
      "requiredChildren": [
        "button.ds-dropdown__trigger",
        "span.ds-dropdown__trigger-text",
        "img.ds-dropdown__trigger-arrow",
        "div.ds-dropdown__panel",
        "div.ds-dropdown__list",
        "button.ds-dropdown__item"
      ],
      "isComplete": true,
      "pendingParts": []
    },
    {
      "name": "with-search",
      "chineseName": "带搜索",
      "structure": "panel 内在 list 之前加 ds-dropdown__search",
      "cssClass": "ds-dropdown",
      "isComplete": true,
      "pendingParts": [],
      "requiredChildren": [
        "button.ds-dropdown__trigger",
        "span.ds-dropdown__trigger-text",
        "img.ds-dropdown__trigger-arrow",
        "div.ds-dropdown__panel",
        "div.ds-dropdown__list",
        "button.ds-dropdown__item",
        "div.ds-dropdown__search",
        "input",
        "img.ds-dropdown__search-icon"
      ]
    },
    {
      "name": "multi-select-checkbox",
      "chineseName": "多选 Checkbox",
      "structure": "list item 内加 input[type=checkbox]，item 加 ds-dropdown__item--muted"
    },
    {
      "name": "grouped",
      "chineseName": "分组",
      "structure": "用 ds-dropdown__group-title + ds-dropdown__divider 分隔多组，通常搭配 checkbox，底部可加 ds-dropdown__footer 确认/取消按钮"
    },
    {
      "name": "filter",
      "chineseName": "Filter 筛选",
      "structure": "触发器用 ds-dropdown__filter-trigger（胶囊形，非常规 trigger），panel 内常为多组横向排列的 checkbox"
    },
    {
      "name": "brand-select",
      "chineseName": "品牌选择（小尺寸+搜索）",
      "structure": "触发器加 ds-dropdown__trigger--sm（30px），panel 内 search 用 ds-dropdown__search--bordered",
      "cssClass": "ds-dropdown",
      "isComplete": true,
      "pendingParts": [],
      "requiredChildren": [
        "button.ds-dropdown__trigger",
        "span.ds-dropdown__trigger-text",
        "img.ds-dropdown__trigger-arrow",
        "div.ds-dropdown__panel",
        "div.ds-dropdown__list",
        "button.ds-dropdown__item",
        "div.ds-dropdown__search",
        "input",
        "img.ds-dropdown__search-icon"
      ]
    }
