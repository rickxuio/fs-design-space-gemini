  "identity": {
    "rule": "Preserve five full stars. Display on/off sequence, aria-label and optional label must agree. Input retains group, five radio buttons, output and Clear.",
    "labelRule": "Business grade words must be supplied, not invented. Input groupLabel is nonempty; labels is five strings, empty entries fall back to numeric value.",
    "summary": "Full score-card/stars/count and five read-only progressbar rows; arithmetic and accessible text checked together. Fixture 14/14/14/0/0 gives mean 4.0 over 42 reviews. Original 28/14 specimen remains, mismatch not approved."
  },
  "locked": [
    "Five full stars, size and registered assets",
    "Noninteractive display role=img",
    "Input radiogroup/radio and safe button types",
    "Output and Clear structure",
    "Shared CSS and actual rate.js behavior",
    "data-rate-current marker on input specimens",
    "Read-only summary full fragments and internally consistent integer score/count/ARIA; derived numeric progress widths"
  ],
  "behavior": {
    "display": "No runtime display updater. Structured ratingContent must synchronize icons, aria-label and optional existing label.",
    "initialization": "Current runtime has one document guard and MutationObserver reconciliation for current inputs; no public setValue API. Do not load legacy rate.js alongside it.",
    "preview": "pointerover previews only icons while explanation/hidden state, data-value and aria-checked preserve the committed selection; pointerout restores committed stars.",
    "commit": "Star click, Clear and keyboard emit ds:rate-change even for repeated same value; detail contains value/previousValue/label/source.",
    "keyboard": "Arrows move from the focused button, Home/End select 1/5, Enter/Space commit current star; Clear selects 0 and focuses first star.",
    "disabled": "Runtime initializes disabled class or aria-disabled. Enabled canonical calls do not expose state editing; changing class after initialization does not synchronize runtime state.",
    "business": "No native form field or request. Host listens to the component event.",
    "currentGuard": "Current document guard prevents duplicate event handlers; native disabled fieldsets/explicit custom disabled state update controls and tabstops. Legacy Comment host input without marker is not automatically upgraded.",
    "summary": "Marker-only immutable summary: current initialization derives numeric fill widths from declared count/total; no interaction, event, backend or programmatic update API. Fractional mean and zero reviews are excluded from this finite call.",
    "hover": "Preview stars only; preserve committed explanation text and hidden state until selection. Source v1.2.2604A2.1/4.2."
  },
  "examples": [
    {
      "name": "summary",
      "rootTag": "div",
      "sizeOptions": [],
      "purpose": "read-only-integer-mean-rating-distribution",
      "whenToUse": "只需综合分值、评论总数和 5→1 星数量分布，不需要媒体、标签筛选或评论列表联动时使用。",
      "rootClasses": "ds-rate ds-rate--summary",
      "requiredStructure": [
        "div.ds-rate__score-card",
        "span.ds-rate__stars",
        "div.ds-rate__distribution",
        "span.ds-rate__progress"
      ],
      "slots": {
        "summaryData": {
          "selector": ":scope",
          "mode": "structured-content",
          "required": true,
          "preserve": [
            "div.ds-rate__score-card",
            "span.ds-rate__stars",
            "div.ds-rate__distribution",
            "div.ds-rate__distribution-row",
            "span.ds-rate__progress"
          ],
          "rule": "Exactly five rows from 5 to 1. Counts sum to nonzero total ≤1,000,000; weighted mean must be integer 1–5. Score, count, star assets and ARIA agree. No interactive controls, formatting, initial inline widths or summary update API."
        }
      },
      "allowedEdits": [
        "summaryData"
      ],
      "exampleHtml": "<div class=\"ds-rate ds-rate--summary\" aria-label=\"Rating summary: 4.0 out of 5 from 42 reviews\" data-ai-example=\"ai-rate-summary-integer\" data-rate-summary=\"\">\n        <div class=\"ds-rate__score-card\">\n          <span class=\"ds-rate__summary-score\">4.0</span>\n          <span class=\"ds-rate__stars\" role=\"img\" aria-label=\"4 out of 5 stars\">\n            <img class=\"ds-rate__star\" src=\"../icons/icon-rate-on-16.svg\" alt=\"\">\n            <img class=\"ds-rate__star\" src=\"../icons/icon-rate-on-16.svg\" alt=\"\">\n            <img class=\"ds-rate__star\" src=\"../icons/icon-rate-on-16.svg\" alt=\"\">\n            <img class=\"ds-rate__star\" src=\"../icons/icon-rate-on-16.svg\" alt=\"\">\n            <img class=\"ds-rate__star\" src=\"../icons/icon-rate-off-16.svg\" alt=\"\">\n          </span>\n          <span class=\"ds-rate__review-count\">（42 reviews）</span>\n        </div>\n        <div class=\"ds-rate__distribution\" aria-label=\"Rating distribution\">\n          <div class=\"ds-rate__distribution-row ds-rate__distribution-row--available\">\n            <span>5 stars</span><span class=\"ds-rate__progress\" role=\"progressbar\" aria-label=\"5 stars: 14 reviews\" aria-valuemin=\"0\" aria-valuemax=\"42\" aria-valuenow=\"14\"><span class=\"ds-rate__progress-fill\"></span></span><span class=\"ds-rate__distribution-count\">14</span>\n          </div>\n          <div class=\"ds-rate__distribution-row ds-rate__distribution-row--available\">\n            <span>4 stars</span><span class=\"ds-rate__progress\" role=\"progressbar\" aria-label=\"4 stars: 14 reviews\" aria-valuemin=\"0\" aria-valuemax=\"42\" aria-valuenow=\"14\"><span class=\"ds-rate__progress-fill\"></span></span><span class=\"ds-rate__distribution-count\">14</span>\n          </div>\n          <div class=\"ds-rate__distribution-row ds-rate__distribution-row--available\">\n            <span>3 stars</span><span class=\"ds-rate__progress\" role=\"progressbar\" aria-label=\"3 stars: 14 reviews\" aria-valuemin=\"0\" aria-valuemax=\"42\" aria-valuenow=\"14\"><span class=\"ds-rate__progress-fill\"></span></span><span class=\"ds-rate__distribution-count\">14</span>\n          </div>\n          <div class=\"ds-rate__distribution-row\">\n            <span>2 stars</span><span class=\"ds-rate__progress\" role=\"progressbar\" aria-label=\"2 stars: 0 reviews\" aria-valuemin=\"0\" aria-valuemax=\"42\" aria-valuenow=\"0\"><span class=\"ds-rate__progress-fill\"></span></span><span class=\"ds-rate__distribution-count\">0</span>\n          </div>\n          <div class=\"ds-rate__distribution-row\">\n            <span>1 star</span><span class=\"ds-rate__progress\" role=\"progressbar\" aria-label=\"1 star: 0 reviews\" aria-valuemin=\"0\" aria-valuemax=\"42\" aria-valuenow=\"0\"><span class=\"ds-rate__progress-fill\"></span></span><span class=\"ds-rate__distribution-count\">0</span>\n          </div>\n        </div>\n      </div>"
    }
  ],
