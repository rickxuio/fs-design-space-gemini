    "variantSelectionRules": [
      "已有单个评分值且不允许修改 → display；用户需要选择、修改或清除 1–5 星 → input；只需综合分值、评论总数与 5→1 星数量分布 → summary。",
      "带评论媒体、分类筛选、Helpful、回复或评论列表联动的评分聚合 → Comment/rating-summary，不得使用 Rate/summary。",
      "商品配置、套餐或服务选择 → OptionSelector，不得用星级评分表达业务选项。",
      "display 支持 sm/md/lg；input 只使用 md/lg；summary 固定使用 16px 星与 88×8px 分布条。",
      "固定 5 颗完整星，不生成半星；1–4 星不得自动补造形容词，只有业务明确提供时才显示。"
    ],
    "hardRules": [
      {
        "title": "固定完整五星，并区分评分输入与评论聚合",
        "description": "星形资产、输入语义与聚合边界必须同时成立。",
        "ruleContent": "<strong>Rate 固定为 5 颗完整星，不支持半星。</strong><code>input</code> 必须使用 <code>radiogroup + button[role=radio]</code>，支持 hover 预览、点击提交、Clear 重置和键盘操作；<code>display</code>/<code>summary</code> 只读。包含评论媒体、分类筛选或评论列表联动时必须改用 <code>Comment/rating-summary</code>。",
        "aiParse": "scale = [1, 2, 3, 4, 5]\nhalfStar = false\nvariants = [\"display\", \"input\", \"summary\"]\ninput = { sizes: [\"md\", \"lg\"], semantics: \"radiogroup\", clear: true }\nsummary = { media: false, filters: false, commentList: false }",
        "enforcement": "rate.js 同步值、图标、ARIA、roving tabindex 与 ds:rate-change；契约选型规则阻止与 Comment/rating-summary 混用。"
      }
    ],
    "enforcementStatus": {
      "interaction.value-and-aria": {
