  "identity": {
    "rule": "Complete ID-free track with safe native previous/next arrows. Exact dark seven-slide/dot mapping or light five-slide/no-dot shape. Current marker separates canonical types; no ready/default inline state.",
    "slideContentBoundary": "The scaffold owns track/slide wrappers only. Existing demo body classes are Preview-only page content; replacements require page-level FS content mapping. Interactive contents are excluded because aria-hidden does not remove their focusability."
  },
  "locked": [
    "Homepage root and dark XL overlay controls",
    "Seven complete slide wrappers and one-to-one dots",
    "Registered arrows, safe buttons and initial state",
    "Shared CSS and current runtime",
    "No inference of Banner component from slide demo content",
    "Light five wrappers and L overlay controls, 16px inset and 8px corner from existing specimen; no optional dots in this finite call"
  ],
  "behavior": {
    "navigation": "Previous/next clamp at boundaries; dots switch to matching slide. Track transform, dot active/current, slide aria-hidden and disabled controls synchronize. No dedicated event, autoplay, gestures or business navigation.",
    "initialization": "New current runtime scans opt-in data-carousel-current roots at load/DOMContentLoaded; per-root guard prevents duplicate binding. Original Preview inline runtime archived.",
    "content": "Only noninteractive slide content is within finite scope. Hidden-slide focusability, source image content and page Banner composition require separate checks.",
    "geometry": "13.125% homepage control inset belongs to Carousel; does not supply Banner text inset. Actual browser geometry and animation remain unverified.",
    "nativeStateGuard": "Current next/previous/dot native buttons ignore synthetic clicks while disabled or inside a disabled fieldset; no external slide API or new variant.",
    "availability": "Current controls ignore native-disabled fieldset, ARIA-disabled or hidden host synthetic clicks, preserving current index. No autoplay, swipe or arrow-key navigation API."
  },
  "examples": [
    {
      "name": "light",
      "rootTag": "div",
      "sizeOptions": [],
      "purpose": "light-five-static-slide-l-overlay-no-pagination",
      "rootClasses": "ds-carousel",
      "requiredStructure": [
        "div.ds-carousel__track",
        "div.ds-carousel__slide",
        "button.ds-carousel__btn--prev",
        "button.ds-carousel__btn--next"
