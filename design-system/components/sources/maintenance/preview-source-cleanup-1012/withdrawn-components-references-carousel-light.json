  "selection": {
    "policy": "Dark homepage seven slides/XL dark overlay with seven dots, or light five static slides/L overlay with no optional pagination. Exact registered calls only; slide bodies are page content, not implicit Banner.",
    "supported": [
      "dark",
      "light"
    ],
