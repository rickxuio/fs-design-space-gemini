  "commonProperties": {
    "element": "label > input[type=radio] + .ds-radio__indicator + .ds-radio__content",
    "group": "同一互斥组至少两个 input，共享 name，由浏览器保证唯一 checked",
    "labelPosition": "圆形状态图右侧",
    "gap": "8px",
    "fontFamily": "Open Sans",
    "interaction": "点击标签或容器选中；原生 Tab、方向键与 Space 行为；disabled 不可操作",
    "hover": "仅状态图变化，文本标签不变"
  },
  "usageGuidelines": "同组数量必须大于等于 2，且组内选项互斥。普通文字选项使用 regular-lg/regular-sm；30px 紧凑描边表单项使用 bordered-compact；结算页地址、配送与支付等主副文本选项使用 bordered-detail。只有一个确认项时使用 Checkbox；媒体、颜色、商品、价格或品牌内容本身构成可视化选择项时使用 OptionSelector。 结算详情须区分具体场景：快递示例无外描边，支付方式的Hover/选中圆点为#19191A且选中文字加粗；这些专属形态未建立精确调用前，不冒称现有通用bordered-detail已覆盖。下拉菜单宿主的交互优先遵循Dropdown规范，圆形原子与标签遵循Radio规范。",
  "responsiveRules": [
    "组件宽度由内容或父容器决定，不保留投喂 HTML 的 104px、95px、111px、378px 画板宽度。",
    "PC 横排常规选项间距为 16px；regular-lg 竖排为 16px，regular-sm 竖排可按已核实场景使用 8px 或 4px。",
    "bordered-compact 组间距为 12px；bordered-detail 竖排组间距为 8px。",
    "规范图记录 regular-sm 在 M 端竖排间距为 12px；本仓库页面生成只验收 desktop，不生成移动端媒体查询。"
  ],
