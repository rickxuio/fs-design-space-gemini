  },
  "selection": {
    "policy": "按原件区分 Cookies、FAQ、账户编辑、订单预览、特征导引和地图联动。当前 split/feature/faq/data-preview 按各自来源可调用；参考形态不得套现有类名冒充。默认单项展开；媒体/地图/业务保存需真实宿主实现。 已有FAQ原件可用faq组合：首中尾随行数确定，原箭头与底线状态联动，默认全部收起，单项展开。 List折叠详情先转引本组件data-preview，仅账户订单快照适用，不能冒充FAQ或任意树表。 Current five-variant closure 20261115: only supported exact source examples and publication decisions permit local calls. Earlier preview-only or placeholder descriptions are historical; PC geometry and host boundaries remain explicit.",
    "supported": [
      "split",
      "feature",
      "faq",
      "data-preview",
      "inline-edit"
    ],
    "unsupported": [
      "toggle-aside-canonical-call",
      "feature-media-synchronization",
      "invented-change-event",
      "mobile",
      "v3-faq-atom-six-variants",
      "map-synchronization"
    ]
  },
