{
  "schemaVersion": "fs-component-reference/1.0.0",
  "component": {
    "id": "dialog",
    "name": "Dialog",
    "version": "v2.3.2607A",
    "scope": "five-source-backed-desktop-templates",
    "reviewStatus": {
      "engineering": "pending",
      "visual": "pending",
      "familyCoverage": "partial"
    }
  },
  "selection": {
    "policy": "按内容任务选择information只读说明、confirmation简短删除、form资料填写、cart750px商品表格、message已确认成功消息；禁止通过改宽度/原站嵌入绕过。每种模板只编辑其登记字段，生产动作由宿主接事件，移动和未登记状态不自动开放。",
    "supported": [
      "information",
      "confirmation",
      "form",
      "cart",
      "message"
    ],
    "unsupported": [
      "special-business",
      "mobile",
      "attachment-upload",
      "message-error",
      "message-warning"
    ]
  },
  "runtime": {
    "styles": [
      "components/tokens.css",
      "components/components.css",
      "components/dialog-current.css",
      "components/form-current.css",
      "components/button-current.css",
      "components/button-runtime-current.css",
      "components/input-current.css",
      "components/checkbox-current.css",
      "components/icon-button-current.css",
      "components/input-number-current.css",
      "components/form-dialog-content.css",
      "components/list-dialog-cart.css",
      "components/dialog-templates-current.css"
    ],
    "scripts": [
      "components/dialog-current.js",
      "components/input-current.js",
      "components/checkbox-current.js",
      "components/form-current.js",
      "components/input-number-current.js",
      "components/list-products-current.js",
      "components/dialog-templates-current.js"
    ],
    "trigger": "button[data-dialog-open=\"<dialog-id>\"]",
    "close": "[data-dialog-close]",
    "confirm": "[data-dialog-confirm] → cancelable fs-dialog-confirm event",
    "backdropDismiss": "默认开启；data-dialog-backdrop=\"false\" 可关闭",
    "businessBoundary": "接入方负责业务动作；组件本身不删除、不保存数据。",
    "fontStylesheets": [
      "https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&display=swap"
    ],
    "fontFallback": "在线字体不可用时使用 tokens.css 已声明的系统字体回退；精确视觉审阅需确认 Open Sans 实际加载。"
  },
  "identity": {
    "rule": "为每个实例生成唯一 id，标题 id 同步 aria-labelledby，触发按钮 data-dialog-open 指向实例 id。",
    "attributes": [
      "id",
      "aria-labelledby",
      "data-dialog-open"
    ],
    "labelRule": "替换底部按钮文案时，同步对应 aria-label；关闭图标必须保留可读的无障碍名称。"
  },
  "locked": [
    "dialog 根元素与变体类名",
    "必需结构",
    "组件 CSS / JS",
    "按钮变体与尺寸",
    "关闭图标路径与尺寸",
    "data-dialog-* 行为属性",
    "IconButton/plain-l真实嵌套结构与独立原子样式"
  ],
  "behavior": {
    "open": "使用 data-dialog-open 指向唯一实例 id；调用原生 showModal。",
    "cancel": "关闭、取消、Esc 与普通遮罩关闭均不执行确认动作。",
    "confirm": "监听 fs-dialog-confirm；业务由宿主处理。异步或校验失败时 preventDefault，成功后由宿主 close。",
    "focus": "打开时背景不可交互；关闭后焦点返回触发按钮。",
    "overflow": "只让正文区滚动，不移动头部和底部。",
    "engineeringStatus": "Engineering qualification is derived from components/quality/acceptance.json source/tool fingerprints; current finite browser observations are separate evidence, never a replacement for the original engineering suite or visual approval.",
    "currentRuntime": "One document delegate set, including cancelled confirmations; native/ARIA disabled actions are guarded. Actual two-PC-instance modal/focus/Escape/backdrop/overflow observations are in currentBrowserReview; full business and browser coverage remains unverified. Do not co-load legacy dialog.js.",
    "backdropGesture": "Each click consumes the outside-pointer-start state; pointercancel/close/reopen clear it. Only a fresh outside-start/outside-click closes the enabled backdrop. Actual default click-to-dismiss observed for both PC calls; exhaustive pointer gestures not claimed.",
    "closeAtom": "头部关闭真实调用IconButton/plain-l；宿主仅定位与关闭路由，原子样式修改使Dialog引用过期，重新同步复核；冻结页面保持旧版。"
  },
  "examples": [
    {
      "name": "information",
      "publication": {
        "key": "dialog/information",
        "disposition": "restricted",
        "newPages": true,
        "reason": "只在两种已实现类型范围内选择；不匹配时返回 unsupported，不猜变体。",
        "constraints": [
          "只在两种已实现类型范围内选择；不匹配时返回 unsupported，不猜变体。"
        ],
        "contractPolicy": "只在两种已实现类型范围内选择；不匹配时返回 unsupported，不猜变体。",
        "use": "finite-new-page-candidate",
        "evidence": "components/contracts/dialog.json#aiContract/evidence",
        "requiresCurrentEngineering": true,
        "visualApproval": "separate-not-granted"
      },
      "rootTag": "dialog",
      "type": "information",
      "sizeOptions": [],
      "bindings": {
        "contentSource": {
          "mode": "native-attribute",
          "target": "root",
          "attribute": "data-dialog-content-source",
          "valueType": "nonempty-string",
          "sourceProperty": "Host-supplied content slot; child components retain their own canonical DOM"
        }
      },
      "purpose": "read-information",
      "whenToUse": "只读说明，采用650px原内容提示模板及既有分组结构。",
      "whenNotToUse": "输入表单、加购提示、成功/警告消息、删除确认，或要求任意宽度/新增头底插槽。",
      "rootClasses": "ds-dialog ds-dialog--information",
      "requiredStructure": [
        "header.ds-dialog__header",
        "h2.ds-dialog__title",
        "button.ds-dialog__close-position.ds-icon-btn.ds-icon-btn--plain.ds-icon-btn--l[data-dialog-close]",
        "button.ds-dialog__close-position.ds-icon-btn.ds-icon-btn--plain.ds-icon-btn--l img.ds-icon-btn__icon[src=\"../icons/icon-close.svg\"]",
        "div.ds-dialog__body",
        ".ds-dialog__section",
        ".ds-dialog__content",
        ".ds-dialog__subtitle"
      ],
      "slots": {
        "title": {
          "selector": ".ds-dialog__title",
          "mode": "text",
          "required": true
        },
        "body": {
          "selector": ".ds-dialog__body",
          "mode": "structured-content",
          "required": true,
          "preserve": [
            ".ds-dialog__section",
            ".ds-dialog__subtitle",
            ".ds-dialog__content"
          ]
        }
      },
      "allowedEdits": [
        "title",
        "body",
        "contentSource"
      ],
      "exampleHtml": "<dialog id=\"dialog-info\" class=\"ds-dialog ds-dialog--information\" aria-labelledby=\"dialog-info-title\"><header class=\"ds-dialog__header\"><h2 id=\"dialog-info-title\" class=\"ds-dialog__title\">Pay with eCheck/Check</h2><button class=\"ds-dialog__close-position ds-icon-btn ds-icon-btn--plain ds-icon-btn--l\" type=\"button\" aria-label=\"Close\" data-dialog-close><img class=\"ds-icon-btn__icon\" src=\"../icons/icon-close.svg\" alt=\"\"></button></header><div class=\"ds-dialog__body\"><p>We accept eCheck or Check as the payment to make the purchase convenient for you at any time.</p><div class=\"ds-dialog__section\"><h3 class=\"ds-dialog__subtitle\">Pay with eCheck</h3><div class=\"ds-dialog__content\"><p>Only U.S. bank accounts are accepted for payment by eCheck. To use your Check account as a payment option, please provide the following at Checkout page:</p><ul><li>Your bank routing number</li><li>Your bank account number (typically a checking account)</li><li>The name on your bank account</li></ul></div></div><div class=\"ds-dialog__section\"><h3 class=\"ds-dialog__subtitle\">Pay with Check</h3><div class=\"ds-dialog__content\"><p>Please send your Check to the following address:</p><p>FS.COM Inc.<br>380 Centerpoint Blvd<br>New Castle, DE 19720<br>United States.</p></div></div></div></dialog>"
    }
  ],
