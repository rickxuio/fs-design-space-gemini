        "img",
        ".ds-list"
      ],
      "slots": {
        "image": {
          "selector": ".ds-card__product-image-wrap",
          "mode": "structured-content",
          "required": true,
          "preserve": [
            "img.ds-card__product-image"
          ],
          "rule": "One actual product picture and descriptive alt."
        },
