  "identity": {
    "rule": "Complete actual image + body, selected stack/meta/description wrappers, and real inline-black/M TextButton. No Preview inline sizing, placeholder media or fictitious action child. Bordered horizontal auto-call withdrawn pending scrollbar/tall-content and visual verification; vertical metadata is category plaintext. Current vertical requires data-card-current=vertical-single-event.",
    "assetRule": "Default existing engineering photo is demo/page content, not a design-system icon or MG component asset. Rebase relative image/icon paths when assembled elsewhere."
  },
  "locked": [
    "True Card image/body/content-stack/link hierarchy",
    "Current opt-in Card stylesheet and shared base styles",
    "Genuine TextButton inline-black/M label + registered arrow",
    "Native spacing, typography, radius and states; vertical single-event current parent-grid sizing is defined below, no page CSS overrides",
    "Exact horizontal border or vertical no-border variant; parent surface per contract",
    "Vertical meta/description wrappers and bordered horizontal full bullet fragments",
    "Source on variant: three inside body edges only; root and image unbordered; Default/Hover geometry identical",
    "spliced.vertical.single-event.bordered页面调用须configuration.parentGrid=1200/4/20、quantity4及outputGroup；只声明cardCount4不能冒称真实4栏285几何。"
  ],
  "behavior": {
    "static": "普通内容按真实TextButton导航；产品选购使用真实Tag、List12和Cart，选择/加购业务由宿主处理。原稿和当前调用的资格分别记录。",
    "content": "Image, title, description and link text are page content; existing Pexels photo is replaceable and not MG visual evidence.",
    "source": "Partial native independent norm and actual PC/vertical nodes linked separately from historical generated export; remaining shape/slot/state sources pending.",
    "geometry": "本批实测当前精确调用的受控图文方向、文档宽度和资源。桌面文档渲染不构成全设备视觉批准。"
  },
  "examples": [
    {
      "name": "embedded.product-detail",
      "publication": {
        "key": "card/embedded.product-detail",
        "disposition": "restricted",
        "newPages": true,
        "reason": "Real source shape, owned child parts and finite local runtime; caller owns business requests.",
        "constraints": [
          "产品小图、标题、说明及参数列表，横向嵌入式详情卡片。",
          "没有参数列表、完整选购或价格/库存操作。",
          "Only allowedEdits; real current dependencies and runtime required; visual approval separate."
        ],
