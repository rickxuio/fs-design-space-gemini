          "selector": ".ds-card__product-subtitle",
          "mode": "text",
          "required": true
        },
        "items": {
          "selector": ".ds-list",
          "mode": "structured-content",
          "required": true,
          "preserve": [
            "div.ds-list__unordered-item",
            "span.ds-list__unordered-dot",
            "p.ds-list__unordered-text"
          ],
          "rule": "Real List/unordered-12 rows only."
        }
      },
      "allowedEdits": [
        "image",
        "title",
        "description",
        "items"
      ],
      "exampleHtml": "<div class=\"ds-card--embedded ds-card--embedded-detail ds-card\" data-card-current=\"embedded-detail\" data-ai-example=\"ai-card-completion-embedded-product-detail\">\n          <div class=\"ds-card__product-image-wrap\"><img class=\"ds-card__product-image\" src=\"../sources/card/preview-assets/img-placeholder.svg\" alt=\"Reference product image\"></div>\n          <div class=\"ds-card__product-body\">\n            <div>\n              <p class=\"ds-card__product-title\">IPC301-5M-D</p>\n              <p class=\"ds-card__product-subtitle\">Key Applications: shopping area, entrance and exit</p>\n            </div>\n            <div class=\"ds-list ds-list--unordered-12\" data-list-current=\"unordered\" data-list-source=\"legacy-fixed\"><div class=\"ds-list__unordered-item\"><span class=\"ds-list__unordered-dot\" aria-hidden=\"true\"></span><p class=\"ds-list__unordered-text\">2x 2nd Gen Intel Xeon Scalable CPUs</p></div><div class=\"ds-list__unordered-item\"><span class=\"ds-list__unordered-dot\" aria-hidden=\"true\"></span><p class=\"ds-list__unordered-text\">2x 2nd Gen Intel Xeon Scalable CPUs</p></div><div class=\"ds-list__unordered-item\"><span class=\"ds-list__unordered-dot\" aria-hidden=\"true\"></span><p class=\"ds-list__unordered-text\">2x 2nd Gen Intel Xeon Scalable CPUs</p></div></div>\n          </div>\n        </div>"
    }
