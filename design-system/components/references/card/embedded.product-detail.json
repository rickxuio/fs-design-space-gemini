      "familyCoverage": "partial"
    }
  },
  "selection": {
    "policy": "按普通内容、分类多链接、搜索结果、最近浏览或产品选购选型，再核对布局、背景与设备。当前十个精确调用含描边通栏、嵌入详情和完整产品卡；侧栏仍参考。Card真实引用List、Tag和Cart；仅按allowedEdits修改内容，不自动扩展移动端或业务请求。 Current five-variant closure 20261115: only supported exact source examples and publication decisions permit local calls. Earlier preview-only or placeholder descriptions are historical; PC geometry and host boundaries remain explicit.",
    "supported": [
      "spliced.horizontal.full-width.responsive",
      "spliced.horizontal.full-width",
      "spliced.vertical.single-event",
      "spliced.vertical.single-event.bordered",
