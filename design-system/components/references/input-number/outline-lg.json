  "selection": {
    "policy": "outline-sm用于紧凑数量，outline-lg用于白底常规数量，filled-lg用于灰底表单。取实际默认实例；仅在初始化前替换正整数配置，不通过新增CSS造尺寸。 按relations.variantDecisions的具体场景选型；最终资格读同版catalog，未开放项不自动调用。当前MG核对状态见prototypeRollout，不将既有来源冒称本次在线核对。",
    "supported": [
      "outline-sm",
      "outline-lg",
      "filled-lg"
    ],
    "unsupported": [
      "negative",
      "decimal",
      "unbounded",
