      "exampleHtml": "<div class=\"ds-banner ds-banner--mini\" data-banner-mini-runtime=\"source-three\" data-ai-example=\"ai-banner-mini-current\" role=\"region\" aria-roledescription=\"carousel\" aria-label=\"Product information\"><div class=\"ds-banner__mini-slides\"><div class=\"ds-banner__mini-slide\" id=\"mini-slide-0\" aria-hidden=\"false\"><img class=\"ds-banner__mini-image\" src=\"../../docs/assets/20250901105611h7ydr7.jpg.webp\" alt=\"\"><div class=\"ds-banner__mini-content\"><p class=\"ds-banner__title\">Optical Transceivers Testing</p><p class=\"ds-banner__desc\">Take a look at our test program to get the reliable and high-performaance optical transceivers</p><a class=\"ds-text-btn ds-text-btn--inline ds-text-btn--blue-link ds-text-btn--m\" href=\"#\"><span class=\"ds-text-btn__text\">Learn more</span><img class=\"ds-text-btn__icon\" src=\"../icons/icon-text-button-arrow-right-blue-s.svg\" alt=\"\"></a></div></div><div class=\"ds-banner__mini-slide\" id=\"mini-slide-1\" hidden aria-hidden=\"true\" inert><img class=\"ds-banner__mini-image\" src=\"../../docs/assets/20250901105611h7ydr7.jpg.webp\" alt=\"\"><div class=\"ds-banner__mini-content\"><p class=\"ds-banner__title\">Find Technical Support</p><p class=\"ds-banner__desc\">Find technical support and product resources.</p><a class=\"ds-text-btn ds-text-btn--inline ds-text-btn--blue-link ds-text-btn--m\" href=\"#\"><span class=\"ds-text-btn__text\">Learn more</span><img class=\"ds-text-btn__icon\" src=\"../icons/icon-text-button-arrow-right-blue-s.svg\" alt=\"\"></a></div></div><div class=\"ds-banner__mini-slide\" id=\"mini-slide-2\" hidden aria-hidden=\"true\" inert><img class=\"ds-banner__mini-image\" src=\"../../docs/assets/20250901105611h7ydr7.jpg.webp\" alt=\"\"><div class=\"ds-banner__mini-content\"><p class=\"ds-banner__title\">Warranty and Returns</p><p class=\"ds-banner__desc\">Warranty and returns information.</p><a class=\"ds-text-btn ds-text-btn--inline ds-text-btn--blue-link ds-text-btn--m\" href=\"#\"><span class=\"ds-text-btn__text\">Learn more</span><img class=\"ds-text-btn__icon\" src=\"../icons/icon-text-button-arrow-right-blue-s.svg\" alt=\"\"></a></div></div></div><div class=\"ds-banner__mini-pagination\"><div class=\"ds-carousel__dots\" data-carousel-mini-pagination aria-label=\"Banner positions\"><button class=\"ds-carousel__dot ds-carousel__dot--active\" type=\"button\" aria-label=\"Slide 1\" aria-controls=\"mini-slide-0\" aria-current=\"true\"></button><button class=\"ds-carousel__dot\" type=\"button\" aria-label=\"Slide 2\" aria-controls=\"mini-slide-1\"></button><button class=\"ds-carousel__dot\" type=\"button\" aria-label=\"Slide 3\" aria-controls=\"mini-slide-2\"></button></div></div></div>"
