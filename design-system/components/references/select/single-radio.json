{
  "schemaVersion": "fs-component-reference/1.0.0",
  "component": {
    "id": "select",
    "name": "Select",
    "scope": "existing-desktop-select-nine-default-examples",
    "reviewStatus": {
      "engineering": "pending",
      "visual": "pending",
      "familyCoverage": "local-nine-variants-source-comparison-pending"
    }
  },
  "selection": {
    "policy": "仅表单预设值选择；≤5项改用Radio/Checkbox，导航或临时动作走Dropdown。先单/多选，再搜索/区号/标记/分组；这些是同一Select配置。当前9个有限调用保留，不任意叠加未登记配置。列表默认下展，空间不足时避让，距视口20px；常规最大232px，双列428px。",
    "supported": [
      "single-basic",
      "single-radio",
      "single-check",
      "multi-basic",
      "multi-checkbox",
      "phone-search",
      "search",
      "two-column",
      "grouped-combination"
    ],
    "unsupported": [
      "mobile-bottom-panel",
      "slider",
      "size-overrides",
      "business-submit",
      "dynamic-option-insertion-after-initialization"
    ]
  },
  "runtime": {
    "styles": [
      "components/tokens.css",
      "components/components.css",
      "components/button-current.css",
      "components/button-runtime-current.css",
      "components/input-current.css",
      "components/checkbox-current.css",
      "components/select-current.css"
    ],
    "scripts": [
      "components/select-current.js"
    ],
    "businessBoundary": "ds:select-change回传值；确认型多选面板内为草稿，关闭后清除是立即动作。宿主负责业务提交，组件不生成字段名或请求。"
  },
  "identity": {
    "rule": "为每次装配生成唯一根id、trigger id、panel id和option id，aria-controls同步；复制示例时不能复用原id。运行脚本初始化缺失id，但不修复宿主已有重复id。",
    "labelRule": "触发器aria-label由已选项与占位文案同步；搜索input保留可访问名称。"
  },
  "locked": [
    "根节点及变体类",
    "data-select-mode与data-select-confirm",
    "触发器/面板/搜索/页脚结构",
    "组件CSS与select-current.js",
    "当前42px触发器、图标及嵌套Checkbox/Tag/Button；single-basic可按已核auto原件填充宿主列宽",
    "除options、已声明layout、placeholder/searchLabel与回调外的内容"
  ],
  "behavior": {
    "selection": "单选立即回写并收起；多选逐项回写。ds:select-change包含multiple、values、labels，空字符串是合法值。",
    "confirmation": "data-select-confirm多选面板先编辑草稿，OK提交，Cancel/Escape/离开焦点回滚；关闭态全部清除立即提交。",
    "keyboard": "方向键导航、Escape收起、Tab离开、搜索过滤遵循现有脚本；禁用fieldset与触发器均阻止操作。",
    "initialization": "Complete newly inserted roots initialize once through the existing observer. Assemble option lists before first initialization; replacing/inserting individual options in an initialized list is not an API guarantee. No native form-value binding or persistence.",
    "values": "原始默认示例部分选项没有data-value，现有脚本回退到标签文字；宿主需在提交前按业务约束核对值、重复值和字段映射，组件不生成业务编码。",
    "nativeStateGuard": "One document/root initialization guard. Native disabled/fieldset, hidden or ARIA-disabled ancestors block synthetic choose/search/commit. Hidden or disabled owner closes the panel and silently rolls back pending confirmation. Closed panel options and composing keys cannot select. Dynamic inserted groups initialize once; no native form-value binding or persistence added.",
    "composition": "Track active search composition per owning root. Intermediate input does not filter, and unflagged navigation/Escape keys do not move focus, close or select during composition. End filters the committed query when open/available; closing clears transient composition state while preserving the query. Native browser IME remains pending.",
    "footerButtonAtom": "当前组合分组面板使用outline-gray/xl与outline-black/xl；宿主只负责确认/取消事件和双列装配，不覆盖原子字号、圆角、padding或状态样式。已保存typed实例42px/24px是尺寸依据。",
    "checkboxAtom": "Checkbox(sm)受控标记适配：省略独立input与data-checkbox-control，保留label.ds-checkbox、box和文字；宿主文本钩子只负责查找与截断。宿主管理role=option、选择与checked/disabled类同步，原子拥有尺寸和状态样式。独立Checkbox原生升级不自动给选项添加input；实际浏览器证据待验证。",
    "hostWidth": "Existing single-basic gray source021318 has auto cross sizing; data-select-layout=fill allocates the real root to its host column. Trigger height42, radius, arrow, panel and states remain component-owned. Other variants keep their current sizes.",
    "viewport": "Default down; prefer above when below space is insufficient. Recalculate while open on resize/scroll; preserve20px viewport clearance,232px regular and428px grouped cap.",
    "inputFace": "Nine admitted trigger faces reuse Input paint/state through data-input-adapter. Native button triggers and multi-value control keep their own selection/actions and layout; no editable text field is inserted.",
    "placeholder": "single-basic/search 可传非空纯文本 placeholder；只修改空值提示，不设置默认选项或业务值。search 可传非空 searchLabel，修改搜索输入的可访问名称。未传参保留原规范示例，旧版本不自动开放。"
  },
  "examples": [
    {
      "name": "single-radio",
      "publication": {
        "key": "select/single-radio",
        "disposition": "restricted",
        "newPages": true,
        "reason": "Local normative Preview, typed contract and actual shared dependencies reviewed; finite PC call requires current browser engineering proof. No claim of independent latest MG/whole-family acceptance.",
        "constraints": [
          "只调用当前具体变体的完整PC默认示例；保留原选项标记、尺寸、Checkbox sm及组合页脚真实Button。搜索、单多选和确认/取消遵循现有事件契约，页面消费值；不自动改造Form区号，不提供后台提交或白底Multi新形态。",
          "只允许契约列明的内容参数；工程验证必须当前有效，原规范视觉、子组件结构与资源版本保持。"
        ],
        "contractPolicy": "只调用当前具体变体的完整PC默认示例；保留原选项标记、尺寸、Checkbox sm及组合页脚真实Button。搜索、单多选和确认/取消遵循现有事件契约，页面消费值；不自动改造Form区号，不提供后台提交或白底Multi新形态。",
        "use": "withheld",
        "evidence": "components/contracts/select.json#aiContract/evidence",
        "requiresCurrentEngineering": true,
        "visualApproval": "separate-not-granted"
      },
      "rootTag": "div",
      "sizeOptions": [],
      "bindings": {
        "changeCallback": {
          "mode": "event-handler",
          "target": "root",
          "event": "ds:select-change"
        },
        "layout": {
          "mode": "native-attribute",
          "target": "root",
          "attribute": "data-select-layout",
          "values": [
            "fill"
          ],
          "sourceProperty": "crossSizing:auto"
        },
        "placeholder": {
          "mode": "native-attribute",
          "target": "span.ds-select__value",
          "attribute": "data-placeholder",
          "valueType": "nonempty-string",
          "nonEmpty": true,
          "sourceProperty": "占位文案（内容）"
        }
      },
      "runtimeSemantics": {
        "mode": "single",
        "confirmation": false
      },
      "purpose": "select-single-radio",
      "whenToUse": "表单预设值单选，选项>5，以14px单选图标标识唯一选择。",
      "whenNotToUse": "多选场景。",
      "rootClasses": "ds-select--single-radio",
      "requiredStructure": [
        ".ds-select__trigger",
        ".ds-select__panel",
        ".ds-select__list",
        ".ds-select__option-label",
        ".ds-select__arrow",
        ".ds-select__radio"
      ],
      "slots": {
        "options": {
          "selector": ".ds-select__list",
          "mode": "structured-content",
          "required": true,
          "preserve": [
            ".ds-select__option-label",
            ".ds-select__radio"
          ],
          "boundary": "只替换原选项列表；每项保留role=option、aria-selected及当前变体的标记/组结构。有data-value则按宿主内容绑定保留；未提供时现有脚本以标签文字作为值，不把缺失值推断为业务编码。不改触发器、搜索框或页脚。"
        }
      },
      "allowedEdits": [
        "options",
        "changeCallback",
        "layout",
        "placeholder"
      ],
      "exampleHtml": "<div class=\"ds-select ds-select--single-radio\" data-select-mode=\"single\" data-ai-example=\"ai-select-single-radio\" id=\"ai-select-single-radio\" data-input-current=\"\" data-input-adapter=\"select-trigger\">\n            <button class=\"ds-select__trigger ds-select__trigger--white ds-input-field__input ds-input-field__input--white\" type=\"button\" role=\"combobox\" aria-haspopup=\"listbox\" aria-expanded=\"false\" aria-controls=\"ai-select-single-radio-panel\" id=\"ai-select-single-radio-trigger\"><span class=\"ds-select__value\" data-placeholder=\"Select\">Select</span><img class=\"ds-select__arrow\" src=\"../icons/icon-chevron-down.svg\" alt=\"\"></button>\n            <div class=\"ds-select__panel\" role=\"listbox\" hidden=\"\" id=\"ai-select-single-radio-panel\" aria-labelledby=\"ai-select-single-radio-trigger\">\n              <div class=\"ds-select__list\">\n                <div class=\"ds-select__option\" role=\"option\" aria-selected=\"false\" id=\"ai-select-single-radio-option-0\"><span class=\"ds-select__radio\"></span><span class=\"ds-select__option-label\">1st item</span></div>\n                <div class=\"ds-select__option\" role=\"option\" aria-selected=\"true\" id=\"ai-select-single-radio-option-1\"><span class=\"ds-select__radio\"></span><span class=\"ds-select__option-label\">2nd item</span></div>\n                <div class=\"ds-select__option\" role=\"option\" aria-selected=\"false\" id=\"ai-select-single-radio-option-2\"><span class=\"ds-select__radio\"></span><span class=\"ds-select__option-label\">3rd item</span></div>\n                <div class=\"ds-select__option\" role=\"option\" aria-selected=\"false\" aria-disabled=\"true\" id=\"ai-select-single-radio-option-3\"><span class=\"ds-select__radio\"></span><span class=\"ds-select__option-label\">Disabled item</span></div>\n              </div>\n            </div>\n          </div>"
    }
  ],
