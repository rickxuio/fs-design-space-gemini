  },
  "selection": {
    "policy": "横向同页章节导航；保留实际div tabs、一个激活项及现有Button子组件（红色XL Regular，42px/左右24px）。组件只维护激活态，章节目标、滚动定位和sticky偏移由原页面宿主实现。MG的纵向、溢出菜单、自动居中和M端原件仍为参考，不冒充接口已实现；不代替Tab面板或跨页Navigation。",
    "supported": [
      "anchor-nav"
    ],
    "unsupported": [
      "single-tab",
      "anchor-tag-tabs",
      "custom-cta-variant",
      "built-in-scroll-target",
      "dynamic-insertion",
      "keyboard-tabs",
      "mobile"
    ]
  },
  "runtime": {
    "styles": [
      "components/tokens.css",
      "components/components.css",
      "components/button-current.css",
      "components/button-runtime-current.css"
    ],
    "scripts": [
      "components/anchor-nav-current.js"
    ],
    "fontStylesheets": [
      "https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&display=swap"
    ],
    "fontFallback": "沿用Open Sans；实际字体与浏览器定位待验。"
  },
  "identity": {
    "rule": "保留data-anchor-group和各tab数据标记；默认只有一个激活项。不要复制运行后data-anchor-nav-ready。组件自身不要求额外ID；页面锚点由本地页面映射管理。",
    "labelRule": "tabs仅替换文字与已登记目标数据，保留div；CTA只替换其文字并通过真实button绑定click。"
  },
  "locked": [
    "根/inner/tabs/action结构",
    "div tab及激活底边线",
    "红色Button/xl-regular真实结构与安全type",
    "sticky及共享CSS",
    "运行选择逻辑与页面滚动边界"
  ],
  "behavior": {
    "selection": "marker-only运行脚本在本group切换唯一激活类；隐藏或ARIA禁用不切换。页面按根目录本地流程协调章节滚动，CTA事件单独处理。",
    "initialization": "首次加载或DOMContentLoaded初始化，防止重复绑定；不提供动态插入扫描API。",
    "scroll": "页面有明确章节目标时，由本地页面JS建立目标与选中/滚动对应；组件不自行生成目标或页面流程。",
    "action": "CTA为Button/filled-red/xl-regular，type=button避免宿主form意外提交；actionCallback只绑定CTA自身click，不绑定所有tab点击。",
    "keyboard": "原Preview tab为div，没有键盘tab控件实现；本批不声称已验证完整键盘语义。"
  },
