{
  "schemaVersion": "fs-component-reference/1.0.0",
  "component": {
    "id": "anchor-nav",
    "name": "AnchorNav",
    "scope": "existing-desktop-multitab-anchor-nav-selection-and-red-cta",
    "reviewStatus": {
