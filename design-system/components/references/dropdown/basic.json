{
  "schemaVersion": "fs-component-reference/1.0.0",
  "component": {
    "id": "dropdown",
    "name": "Dropdown",
    "scope": "historical-choice-and-source-pc-command-menus",
    "reviewStatus": {
      "engineering": "pending",
      "visual": "pending",
      "familyCoverage": "partial"
    }
  },
  "selection": {
    "policy": "新页面只选command-text、command-dot、account-guest、account-signed-in命令菜单；按实际入口与账户状态选择，placement只用各自来源枚举。basic等旧选择型保留兼容但不推荐；值选择用Select。命令通过可取消ds:dropdown-action交给宿主，不执行认证、删除或远程业务。",
    "supported": [
      "basic",
      "with-search",
      "brand-select",
      "command-text",
      "command-dot",
      "account-guest",
      "account-signed-in"
    ],
    "unsupported": [
      "multi-select-checkbox",
      "grouped",
      "filter",
      "native-form-submission",
      "dynamic-options-after-initialization",
      "custom-option-markup",
      "preselected-canonical",
      "full-family-source-and-visual-approval"
    ]
  },
  "runtime": {
    "styles": [
      "components/tokens.css",
      "components/components.css",
      "components/button-current.css",
      "components/button-runtime-current.css",
      "components/checkbox-current.css",
      "components/icon-button-current.css",
      "components/dropdown-current.css",
      "components/dropdown-command-current.css"
    ],
    "scripts": [
      "components/dropdown-current.js",
      "components/dropdown-command-current.js"
    ],
    "fontStylesheets": [
      "https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&display=swap"
    ]
  },
  "identity": {
    "rule": "Opt-in closed native trigger + unique paired hidden panel/listbox/native options. Search shapes preserve native labeled field, registered search icon and exact variant marker; brand adds 30px trigger/bordered-search. Keyboard behavior is local implementation upgrade, not original MG source proof."
  },
  "locked": [
    "Real native trigger, listbox and option hierarchy",
    "Closed authored state and unique panel identity",
    "Current own reset/runtime resources",
    "Existing shared FS colors/spacing/42px trigger"
  ],
  "behavior": {
    "events": "ds:dropdown-change only for changed selected value, detail={value,label}. Filtering emits no value-change event and preserves selected value. No request/submission.",
    "keyboard": "Native trigger Enter/Space click; arrows open/move and skip disabled, Home/End, Escape closes and returns focus, Tab/outside/focusout close.",
    "initialization": "One document guard and one root guard. Options cannot be replaced after initialization; a page-owned bridge is needed for FormData.",
    "search": "Search/brand opens to search input; ArrowDown/Up move to first/last visible enabled option, Enter selects first match (prevents implicit form submit), Escape/Tab/outside close. No matches leaves choices empty and search focused. Filter persists on close; reset restores empty query/unselected placeholder.",
    "disabled": "Native disabled/fieldset guard ignores selection/search synthetic events and closes an open panel when disabled. No dynamic option insertion or remote filtering.",
    "composition": "Track search compositionstart/end as well as event.isComposing; while active, intermediate input and trigger/option/search keys do not filter or select. compositionend filters the committed query only when search is available. Closing clears transient composition state while preserving query/selection; reset restores initial empty values. Actual browser IME behavior remains pending.",
    "availability": "Native fieldset, ARIA-disabled or hidden host closes panel and rejects synthetic trigger/selection; selected value and query are retained. Disabled options do not enter the keyboard queue.",
    "commands": "Hover/click, outside/Escape/Tab dismissal, keyboard navigation and viewport-safe placement; pointer can reach menu without losing hover. Intent event does not change trigger copy."
  },
  "examples": [
    {
      "name": "basic",
      "publication": {
        "key": "dropdown/basic",
        "disposition": "restricted",
        "newPages": false,
        "reason": "Historical explicit compatibility only; excluded from all new-page candidates.",
        "constraints": [
          "Historical explicit compatibility only; excluded from all new-page candidates."
        ],
        "contractPolicy": "新页面不自动召回本历史选择型Dropdown；选择型需求先确认Select的具体契约/Preview。保留basic/with-search/brand-select三个显式历史兼容调用；六种本地来源形态属于Select组合，不能冒称MasterGo动作Dropdown。动作菜单无完整来源/调用时保持待确认，不借用选择型实现。",
        "use": "compatibility-or-source-display-only",
        "evidence": "components/contracts/dropdown.json#aiContract/evidence",
        "requiresCurrentEngineering": false,
        "visualApproval": "separate-not-granted"
      },
      "rootTag": "div",
      "sizeOptions": [],
      "bindings": {
        "panelIdentity": {
          "mode": "linked-identity",
          "target": "div.ds-dropdown__panel",
          "attribute": "id",
          "valueType": "safe-dom-id",
          "unique": true,
          "references": [
            {
              "selector": "button.ds-dropdown__trigger",
              "attribute": "aria-controls"
            }
          ]
        },
        "changeCallback": {
          "mode": "event-handler",
          "target": "root",
          "event": "ds:dropdown-change"
        }
      },
      "purpose": "finite-basic-native-single-choice",
      "whenToUse": "历史选择型基础示例的归档对照。",
      "whenNotToUse": "新页面选择需求或动作菜单。",
      "rootClasses": "ds-dropdown",
      "requiredStructure": [
        "button.ds-dropdown__trigger",
        "span.ds-dropdown__trigger-text",
        "img.ds-dropdown__trigger-arrow",
        "div.ds-dropdown__panel",
        "div.ds-dropdown__list",
        "button.ds-dropdown__item"
      ],
      "slots": {
        "placeholder": {
          "selector": "span.ds-dropdown__trigger-text",
          "mode": "text",
          "required": true
        },
        "options": {
          "selector": "div.ds-dropdown__list",
          "mode": "structured-content",
          "required": true,
          "preserve": [
            "button.ds-dropdown__item"
          ],
          "rule": ">=2 uniquely valued native buttons with nonempty plain labels; role option, tabindex -1 and aria-selected false authored. Disabled allowed. Keep named listbox."
        }
      },
      "allowedEdits": [
        "placeholder",
        "options",
        "panelIdentity",
        "changeCallback"
      ],
      "exampleHtml": "<div class=\"ds-dropdown\" data-dropdown-current=\"\" data-ai-example=\"ai-dropdown-basic-current\" data-value=\"\"><button class=\"ds-dropdown__trigger\" type=\"button\" aria-haspopup=\"listbox\" aria-expanded=\"false\" aria-controls=\"dropdown-basic-current-panel\"><span class=\"ds-dropdown__trigger-text\">Select</span><img class=\"ds-dropdown__trigger-arrow\" src=\"../icons/icon-chevron-down.svg\" alt=\"\"></button><div class=\"ds-dropdown__panel\" id=\"dropdown-basic-current-panel\" hidden=\"\"><div class=\"ds-dropdown__list\" role=\"listbox\" aria-label=\"Available choices\"><button class=\"ds-dropdown__item\" type=\"button\" role=\"option\" aria-selected=\"false\" tabindex=\"-1\" value=\"item-1\">1st item</button><button class=\"ds-dropdown__item\" type=\"button\" role=\"option\" aria-selected=\"false\" tabindex=\"-1\" value=\"item-2\">2nd item</button><button class=\"ds-dropdown__item\" type=\"button\" role=\"option\" aria-selected=\"false\" tabindex=\"-1\" value=\"item-3\">3rd item</button><button class=\"ds-dropdown__item\" type=\"button\" role=\"option\" aria-selected=\"false\" tabindex=\"-1\" value=\"item-4\">4th item</button><button class=\"ds-dropdown__item\" type=\"button\" role=\"option\" aria-selected=\"false\" tabindex=\"-1\" value=\"item-5\">5th item</button></div></div></div>"
    }
  ],
