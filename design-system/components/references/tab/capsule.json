  "identity": {
    "rule": "Authored first active item plus one indicator; each item keeps complete inner/text structure. Runtime creates tablist/tab, unique aria-selected and roving tabindex. Do not copy data-tab-ready or initialized roles/tabindex.",
    "labelRule": "items replaces existing visible labels and item count, min two; retain product icon wrappers and locked local example assets. Source-specific content targets and panels are page integration.",
