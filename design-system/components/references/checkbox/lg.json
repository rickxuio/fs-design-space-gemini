{
  "schemaVersion": "fs-component-reference/1.0.0",
  "component": {
    "id": "checkbox",
    "name": "Checkbox",
    "scope": "desktop-native-checkbox-two-sizes",
    "reviewStatus": {
      "engineering": "pending",
      "visual": "pending",
      "familyCoverage": "partial"
    }
  },
  "selection": {
    "policy": "普通同组复选应≥2且不互斥；协议/记住密码/保持登录等明确布尔开关可单项。按宿主来源选lg18/14文字或sm14/13文字。保留原生input，不复制宿主受控标记为独立Checkbox。",
    "supported": [
      "lg",
      "sm"
    ],
    "unsupported": [
      "host-marker-without-label",
      "indeterminate-state-edit",
      "disabled-indeterminate",
      "mobile",
      "browser-keyboard-acceptance-pending",
      "linked-text-slot"
    ]
  },
  "runtime": {
    "styles": [
      "components/tokens.css",
      "components/components.css",
      "components/checkbox-current.css"
    ],
    "scripts": [
      "components/checkbox-current.js"
    ],
    "fontStylesheets": [
      "https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&display=swap"
    ],
    "fontFallback": "沿用现有Open Sans字体栈；远端字体不可用时回退，不宣称离线视觉一致。"
  },
  "identity": {
    "rule": "默认规范实例为未选且启用的原生input，必须保留两个当前标记、input类型和name/value；编辑状态限声明bindings。",
    "labelRule": "根节点保留input、aria-hidden方块与唯一纯文字槽。"
  },
  "locked": [
    "label根节点与尺寸类",
    "直接子节点input、box、label及其顺序",
    "原生checkbox类型与背景图资源",
    "共享CSS与图标文件",
    "data-checkbox-current及data-checkbox-control",
    "历史资源不自动升级",
    "Current native root hugs content width with max-width100%; no parent stretch or fixed104/95px specimen width."
  ],
  "behavior": {
    "default": "规范实例默认未选且启用。",
    "interaction": "原生input负责点击、checked、disabled和表单取值，change事件原生冒泡；不模拟Space。当前JS仅初始化半选并在非取消reset后恢复初始半选。",
    "hosts": "Select/Dropdown省略input的受控标记由宿主管理选择。OptionSelector服务span根input+box、List toolbar label根input+box省略caption，沿实际来源保留原子22/lg或20/sm首行wrapper高度与top2/3偏移；外层业务label或input可访问名称供名。List PC行保留完整原子标题；M历史适配未验收。",
    "states": "checked/disabled可通过声明binding配置。半选可由input.indeterminate设置，当前初始化标记只在专用演示中使用，未开放AI binding。disabled+indeterminate未取得源规范。保留原子F6F6F8与规范F6F6F6冲突；浏览器视觉和真实键盘待验证。"
  },
