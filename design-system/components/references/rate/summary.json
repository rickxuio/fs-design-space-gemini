{
  "schemaVersion": "fs-component-reference/1.0.0",
  "component": {
    "id": "rate",
    "name": "Rate",
    "scope": "finite-display-source-clear-input-and-count-derived-summary",
    "reviewStatus": {
      "engineering": "pending",
      "visual": "pending",
      "familyCoverage": "partial"
    }
  },
  "selection": {
    "policy": "单值只读用display；邀评输入用input；综合分值、评价总数和5至1星统计用summary。summary仅接受五项统计数量和筛选事件，固定16px官方图标、浅灰评分块及88px统计条。带图库和标签用Comment/rating-summary，它真实引用Rate/summary。原input尺寸与Clear限制保持；小数汇总只做显示适配，不开放半星输入或自由配色。",
    "supported": [
      "display",
      "input",
      "summary"
    ],
    "unsupported": [
      "half-star",
      "input-sm",
      "disabled-canonical-call",
      "dynamic-insertion-api",
      "programmatic-set-api",
      "native-form-value",
      "mobile",
      "summary-data-update-api",
      "input-explanation-with-clear",
      "universal-form-clear"
    ]
  },
  "runtime": {
    "styles": [
      "components/tokens.css",
      "components/components.css",
      "components/rate-summary-current.css"
    ],
    "scripts": [
      "components/rate-current.js",
      "components/rate-summary-current.js"
    ],
    "fontStylesheets": [
      "https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&display=swap"
    ],
    "fontFallback": "Open Sans stack; current source summary measured with local Open Sans400/600; whole-family visual approval remains pending."
  },
  "identity": {
    "rule": "Display/input preserve five full stars; aggregate summary uses five official SVG layers with documented decimal display cropping. Display on/off sequence, aria-label and optional label agree. Canonical input retains group, five radio buttons, hidden machine output and Clear, with locked data-rate-clear-only. Clear-only does not display explanation alongside Clear.",
    "labelRule": "Business grade words must be supplied, not invented. Input groupLabel is nonempty; labels is five strings, empty entries fall back to numeric value.",
    "summary": "统计数量唯一驱动一位小数分值、官方星图显示、总数、分布及可访问标签；原件示例算术冲突保留在来源，不照抄成业务数据。"
  },
  "locked": [
    "Five official stars and finite sizes; display/input integer-only, summary count-derived display",
    "Noninteractive display role=img",
    "Input radiogroup/radio and safe button types",
    "Output and Clear structure",
    "Shared CSS and actual rate.js behavior",
    "data-rate-current marker on input specimens",
    "Count-derived summary,official SVGs,source geometry,semantic progress and cancelable filter; decimal visual clipping is a documented display adaptation",
    "Canonical clear-only marker and hidden machine output; no visible explanation/Clear combination"
  ],
  "behavior": {
    "display": "No runtime display updater. Structured ratingContent must synchronize icons, aria-label and optional existing label.",
    "initialization": "Current runtime has one document guard and MutationObserver reconciliation for current inputs; no public setValue API. Do not load legacy rate.js alongside it.",
    "preview": "pointerover previews only icons while explanation/hidden state, data-value and aria-checked preserve the committed selection; pointerout restores committed stars.",
    "commit": "Star click, Clear and keyboard emit ds:rate-change even for repeated same value; detail contains value/previousValue/label/source.",
    "keyboard": "Arrows move from the focused button, Home/End select 1/5, Enter/Space commit current star; Clear selects 0 and focuses first star.",
    "disabled": "Runtime initializes disabled class or aria-disabled. Enabled canonical calls do not expose state editing; changing class after initialization does not synchronize runtime state.",
    "business": "No native form field or request. Host listens to the component event.",
    "currentGuard": "Current document guard prevents duplicate event handlers; native disabled fieldsets/explicit custom disabled state update controls and tabstops. Legacy Comment host input without marker is not automatically upgraded.",
    "summary": "Source-bound summary: gray score card,official16px on/off SVGs,88px progress; counts derive score,total and percentage. Hover/focus underline,Gray7 surface and white empty track;13px feedback; cancelable ds:rate-filter. Decimal star clipping is a documented display adaptation, not a new input variant or visual approval.",
    "hover": "Preview stars only; preserve committed explanation text and hidden state until selection. Source v1.2.2604A2.1/4.2.",
    "clearOnly": "Locked data-rate-clear-only keeps output hidden for initialization, hover, commits and Clear; callback data remains available. Unmarked generic input behavior unchanged."
  },
  "examples": [
    {
      "name": "summary",
      "publication": {
        "key": "rate/summary",
        "disposition": "restricted",
        "newPages": true,
        "constraints": [
          "MG69772:106234 bounded source; counts derive arithmetic; official16px glyphs;88px distribution; gray base; visual approval separate"
        ],
        "reason": "Source-backed summary with actual Comment child reuse; host handles filter intents.",
        "visualApproval": "separate-not-granted"
      },
      "rootTag": "div",
      "sizeOptions": [],
      "bindings": {
        "counts": {
          "mode": "native-attribute",
          "target": "root",
          "attribute": "data-rate-summary-counts",
          "valueType": "json-integer-array",
          "length": 5,
          "min": 0,
          "max": 1000000
        },
        "filterCallback": {
          "mode": "event-handler",
          "target": "root",
          "event": "ds:rate-filter"
        }
      },
      "purpose": "count-derived-rating-summary",
      "whenToUse": "产品综合评分、评价数量、5至1星占比及统计筛选。",
      "whenNotToUse": "把输入评分或整套评论列表当汇总。",
      "rootClasses": "ds-rate ds-rate--summary",
      "requiredStructure": [
        "div.ds-rate__score-card",
        "span.ds-rate__stars",
        "div.ds-rate__distribution",
        "span.ds-rate__progress"
      ],
      "slots": {},
      "allowedEdits": [
        "counts",
        "filterCallback"
      ],
      "exampleHtml": "<div class=\"ds-rate ds-rate--summary\" data-rate-summary-current=\"\" data-rate-summary-counts=\"[28,14,0,0,0]\" data-ai-example=\"ai-rate-summary-current\" aria-label=\"Rating summary: 4.7 out of 5 from 42 reviews\"><div class=\"ds-rate__score-card\"><span class=\"ds-rate__summary-score\">4.7</span><span class=\"ds-rate__stars\" role=\"img\" aria-label=\"4.7 out of 5 stars\"><span class=\"ds-rate__summary-star\"><img class=\"ds-rate__star\" src=\"../icons/icon-rate-off-16.svg\" alt=\"\"><span class=\"ds-rate__summary-star-fill\"><img class=\"ds-rate__star\" src=\"../icons/icon-rate-on-16.svg\" alt=\"\"></span></span><span class=\"ds-rate__summary-star\"><img class=\"ds-rate__star\" src=\"../icons/icon-rate-off-16.svg\" alt=\"\"><span class=\"ds-rate__summary-star-fill\"><img class=\"ds-rate__star\" src=\"../icons/icon-rate-on-16.svg\" alt=\"\"></span></span><span class=\"ds-rate__summary-star\"><img class=\"ds-rate__star\" src=\"../icons/icon-rate-off-16.svg\" alt=\"\"><span class=\"ds-rate__summary-star-fill\"><img class=\"ds-rate__star\" src=\"../icons/icon-rate-on-16.svg\" alt=\"\"></span></span><span class=\"ds-rate__summary-star\"><img class=\"ds-rate__star\" src=\"../icons/icon-rate-off-16.svg\" alt=\"\"><span class=\"ds-rate__summary-star-fill\"><img class=\"ds-rate__star\" src=\"../icons/icon-rate-on-16.svg\" alt=\"\"></span></span><span class=\"ds-rate__summary-star\"><img class=\"ds-rate__star\" src=\"../icons/icon-rate-off-16.svg\" alt=\"\"><span class=\"ds-rate__summary-star-fill\"><img class=\"ds-rate__star\" src=\"../icons/icon-rate-on-16.svg\" alt=\"\"></span></span></span><span class=\"ds-rate__review-count\">(42 reviews)</span></div><div class=\"ds-rate__distribution\" role=\"group\" aria-label=\"Rating distribution\"><button class=\"ds-rate__distribution-row\" type=\"button\" value=\"5\" aria-pressed=\"false\" aria-describedby=\"rate-summary-tooltip-5\"><span class=\"ds-rate__distribution-label\">5 stars</span><span class=\"ds-rate__progress\" role=\"progressbar\" aria-label=\"5 stars: 28 reviews\" aria-valuemin=\"0\" aria-valuemax=\"42\" aria-valuenow=\"28\"><span class=\"ds-rate__progress-fill\"></span></span><span class=\"ds-rate__distribution-count\">28</span><span class=\"ds-rate__summary-tooltip\" role=\"tooltip\" id=\"rate-summary-tooltip-5\" hidden=\"\">28 reviews</span></button><button class=\"ds-rate__distribution-row\" type=\"button\" value=\"4\" aria-pressed=\"false\" aria-describedby=\"rate-summary-tooltip-4\"><span class=\"ds-rate__distribution-label\">4 stars</span><span class=\"ds-rate__progress\" role=\"progressbar\" aria-label=\"4 stars: 14 reviews\" aria-valuemin=\"0\" aria-valuemax=\"42\" aria-valuenow=\"14\"><span class=\"ds-rate__progress-fill\"></span></span><span class=\"ds-rate__distribution-count\">14</span><span class=\"ds-rate__summary-tooltip\" role=\"tooltip\" id=\"rate-summary-tooltip-4\" hidden=\"\">14 reviews</span></button><button class=\"ds-rate__distribution-row\" type=\"button\" value=\"3\" aria-pressed=\"false\" aria-describedby=\"rate-summary-tooltip-3\" disabled=\"\"><span class=\"ds-rate__distribution-label\">3 stars</span><span class=\"ds-rate__progress\" role=\"progressbar\" aria-label=\"3 stars: 0 reviews\" aria-valuemin=\"0\" aria-valuemax=\"42\" aria-valuenow=\"0\"><span class=\"ds-rate__progress-fill\"></span></span><span class=\"ds-rate__distribution-count\">0</span><span class=\"ds-rate__summary-tooltip\" role=\"tooltip\" id=\"rate-summary-tooltip-3\" hidden=\"\">0 reviews</span></button><button class=\"ds-rate__distribution-row\" type=\"button\" value=\"2\" aria-pressed=\"false\" aria-describedby=\"rate-summary-tooltip-2\" disabled=\"\"><span class=\"ds-rate__distribution-label\">2 stars</span><span class=\"ds-rate__progress\" role=\"progressbar\" aria-label=\"2 stars: 0 reviews\" aria-valuemin=\"0\" aria-valuemax=\"42\" aria-valuenow=\"0\"><span class=\"ds-rate__progress-fill\"></span></span><span class=\"ds-rate__distribution-count\">