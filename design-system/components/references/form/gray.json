{
  "schemaVersion": "fs-component-reference/1.0.0",
  "component": {
    "id": "form",
    "name": "Form",
    "scope": "two-finite-native-desktop-forms",
    "reviewStatus": {
      "engineering": "pending",
      "visual": "pending",
      "familyCoverage": "partial"
    }
  },
  "selection": {
    "policy": "先判断固定表单还是来源初始字段组合，再按背景选gray/white。gray支持sourceFields，white仍只支持固定结构；来源字段、选项、必填/可选及提示保留，不补造联系方式或隐私同意。Input/Select/Textarea/Checkbox/Button沿用原依赖。sourceFields仅支持已声明text/email/textarea/select，不从MG文件上传/验证码/多步骤原件推断当前接口支持。只做本地校验及ds:form-submit；网络提交、区号搜索、完整成功弹窗与移动表单仍未开放，不用原站iframe替代。",
    "supported": [
      "gray",
      "white"
    ],
    "unsupported": [
      "white-responsive",
      "production-policy-validation",
      "network-submit",
      "country-code-selection",
      "new-device-acceptance"
    ]
  },
  "runtime": {
    "styles": [
      "components/tokens.css",
      "components/components.css",
      "components/form-current.css",
      "components/button-current.css",
      "components/button-runtime-current.css",
      "components/input-current.css",
      "components/checkbox-current.css",
      "components/select-current.css",
      "components/form-dialog-content.css"
    ],
    "scripts": [
      "components/input-current.js",
      "components/checkbox-current.js",
      "components/form-current.js",
      "components/select-current.js"
    ],
    "fontStylesheets": [
      "https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&display=swap"
    ]
  },
  "identity": {
    "rule": "Native form, three two-column PC rows, linked unique IDs/names, counter/contact/consent/Submit and two display-only legal links. All six Input slots use complete atomic DOM; both fifth and gray sixth arrow=down. Phone inner external/start Input; prefix is genuine Input-owned static assembly. No Dropdown/options/hidden bridge."
  },
  "locked": [
    "Genuine Input calls at registered slots and exact Submit/Button/L; native text-field identities; no invented Dropdown/options.",
    "No inline style, SVG, action URL or transport behavior",
    "White card marker, gray-9 surface, spacing.20 and border-radius.lg; matching white native fields",
    "Native Form row/field wrappers and real child atoms; specimen row count, contact and consent copy are not universal business requirements."
  ],
  "behavior": {
    "submission": "Native submit always prevented; valid local FormData entries emitted as ds:form-submit. Page owns business policies, persistence and request handling; no successful transaction is invented.",
    "reset": "Native reset restores text fields and textarea counter; canceled reset preserves values.",
    "counter": "maxlength 5000 and UTF-16 native textarea length counter; user-entered text never inserted as HTML.",
    "links": "Existing demo legal text remains visible; no navigation target claimed for Preview fixture.",
    "initialization": "Single document/root guard. Dynamic fields/options, country selection and native Input component replacement not supported in this finite call.",
    "nativeStateGuard": "Disabled native/ARIA submitter blocks synthetic submit, including inherited fieldset disable. Existing business validation and FormData semantics unchanged.",
    "phonePrefix": "The +1 prefix is static source display with an arrow; no country selector behavior was provided or invented.",
    "submit": "Hidden/ARIA-disabled ancestor or native-disabled submitter blocks synthetic submit without changing values. Valid local submit dispatches only ds:form-submit; business transport remains excluded.",
    "assembly": "Existing gray sourceFields resolves a retained original content record. Native paired rows, full-row textareas, source-required native fields and independently rendered Select. Omit absent demo consent/contact/phone; legacy fieldContent fixture remains strict. No network submission."
  },
  "examples": [
    {
      "name": "gray",
      "publication": {
        "key": "form/gray",
        "disposition": "restricted",
        "newPages": true,
        "reason": "PC gray/white native forms and local event only; phone prefix is static display, not a country selector; no dynamic fields/mobile/production submit.",
        "constraints": [
          "PC gray/white native forms and local event only; phone prefix is static display, not a country selector; no dynamic fields/mobile/production submit."
        ],
        "contractPolicy": "Finite PC gray/white native Forms. Six basic Input atoms plus textarea and static phone prefix per PC form; both fifth fields and gray sixth have decorative down arrows. Checkbox atoms integrated; full M admission and whole-family acceptance remain pending.",
        "use": "finite-new-page-candidate",
        "evidence": "components/contracts/form.json#aiContract/evidence",
        "requiresCurrentEngineering": true,
        "visualApproval": "separate-not-granted"
      },
      "rootTag": "form",
      "sizeOptions": [],
      "bindings": {
        "submitCallback": {
          "mode": "event-handler",
          "target": "root",
          "event": "ds:form-submit"
        },
        "sourceFields": {
          "mode": "source-form-fields",
          "target": "root",
          "referenceKind": "original-page-content-reference",
          "kinds": [
            "text",
            "email",
            "textarea",
            "select"
          ],
          "maxFields": 32,
          "rule": "Retained original fields only; repeat actual Input/textarea and real Select, preserve source order/required/options. No invented consent or business transport; no arbitrary HTML. Select占位优先使用来源字段placeholder，缺省为Select；搜索可访问名称使用Search加来源字段label，不继承品牌示例文案。"
        }
      },
      "purpose": "finite-gray-native-form-with-local-submit-event",
      "whenToUse": "白色背景的既有灰底字段表单，或已保留来源字段的初始组合。",
      "whenNotToUse": "需要网络提交、新设备、任意HTML或未支持的字段类型。",
      "rootClasses": "ds-form",
      "requiredStructure": [
        "p.ds-form__title",
        "p.ds-form__desc",
        "div.ds-form__row",
        "label.ds-input-field__label",
        "input.ds-input-field__input",
        "textarea.ds-input-field__input",
        "span.ds-input-field__count",
        "label.ds-checkbox[data-checkbox-control]",
        "label.ds-form__consent",
        "button.ds-btn",
        "span.ds-btn__text",
        "div.ds-input-field[data-input-arrow=\"down\"]"
      ],
      "slots": {
        "title": {
          "selector": "p.ds-form__title",
          "mode": "text",
          "required": false
        },
        "description": {
          "selector": "p.ds-form__desc",
          "mode": "text",
          "required": false
        },
        "fieldContent": {
          "selector": ":scope",
          "mode": "structured-content",
          "required": true,
          "preserve": [
            "input.ds-input-field__input",
            "textarea.ds-input-field__input",
            "label.ds-form__consent",
            "button.ds-btn",
            "input.ds-input-field__input"
          ],
          "rule": "Source-bound initial field composition from existing native Input/textarea slots and separately confirmed Select; keep exact child anatomy, source order, paired ordinary rows and full-width textareas. No invented business field, consent, option or custom state paint. Canonical Preview remains one full example, not a fixed business schema."
        },
        "submitLabel": {
          "selector": "span.ds-btn__text",
          "mode": "text",
          "required": true
        }
      },
      "allowedEdits": [
        "title",
        "description",
        "fieldContent",
        "submitLabel",
        "submitCallback",
        "sourceFields"
      ],
      "exampleHtml": "<form class=\"ds-form\" data-form-current=\"\" data-ai-example=\"ai-form-gray-current\">\n        <p class=\"ds-form__title\">Product and Project Inquiry</p>\n        <p class=\"ds-form__desc\">Have a question about purchasing a product or solution that you are interested in? Fill in the form and we'll respond in 1 working day.</p>\n        <div class=\"ds-form__row\">\n          <div class=\"ds-form__field\"><div class=\"ds-input-field\" data-input-current=\"\" data-input-layout=\"fill\"><label class=\"ds-input-field__label\" for=\"form-native-example-1\">Label</label><input class=\"ds-input-field__input ds-input-field__input--gray\" placeholder=\"Please enter text\" id=\"form-native-example-1\" type=\"text\" name=\"fieldOne\"><div class=\"ds-input-field__error\" id=\"form-native-example-1-error\" hidden><span class=\"ds-input-field__error-icon\" aria-hidden=\"true\"></span><span class=\"ds-input-field__error-text\">Please enter text.</span></div></div></div>\n          <div class=\"ds-form__field\"><div class=\"ds-input-field\" data-input-current=\"\" data-input-layout=\"fill\"><label class=\"ds-input-field__label\" for=\"form-native-example-2\">Label</label><input class=\"ds-input-field__input ds-input-field__input--gray\" placeholder=\"Please enter text\" id=\"form-native-example-2\" type=\"text\" name=\"fieldTwo\"><div class=\"ds-input-field__error\" id=\"form-native-example-2-error\" hidden><span class=\"ds-input-field__error-icon\" aria-hidden=\"true\"></span><span class=\"ds-input-field__error-text\">Please enter text.</span></div></div></div>\n        </div>\n        <div class=\"ds-form__row\">\n          <div class=\"ds-form__field\"><div class=\"ds-input-field\" data-input-current=\"\" data-input-layout=\"fill\"><label class=\"ds-input-field__label\" for=\"form-native-example-3\">Label</label><input class=\"ds-input-field__input ds-input-field__input--gray\" placeholder=\"Please enter text\" id=\"form-native-example-3\" type=\"text\" name=\"fieldThree\"><div class=\"ds-input-field__error\" id=\"form-native-example-3-error\" hidden><span class=\"ds-input-field__error-icon\" aria-hidden=\"true\"></span><span class=\"ds-input-field__error-text\">Please enter text.</span></div></div></div>\n          <div class=\"ds-form__field\">\n            <label class=\"ds-input-field__label\" data-input-current for=\"form-native-example-4\">Phone Number</label>\n            <div class=\"ds-form__phone-row\">\n              <div class=\"ds-input-prefix\" data-input-current data-input-prefix=\"static\" data-input-color=\"gray\" aria-label=\"Country code +1\"><span>+1</span><img src=\"../icons/icon-input-down.svg\" alt=\"\"></div>\n              <div class=\"ds-input-field\" data-input-current data-input-layout=\"fill\" data-input-label=\"external\" data-input-join=\"start\">\n                <input class=\"ds-input-field__input ds-input-field__input--gray\" placeholder=\"\" id=\"form-native-example-4\" type=\"text\" name=\"phone\">\n                <div class=\"ds-input-field__error\" id=\"form-native-example-4-error\" hidden><span class=\"ds-input-field__error-icon\" aria-hidden=\"true\"></span><span class=\"ds-input-field__error-text\">Please check this value.</span></div>\n              </div>\n            </div>\n          </div>\n        </div>\n        <div class=\"ds-form__row\">\n          <div class=\"ds-form__field\"><div class=\"ds-input-field\" data-input-current data-input-layout=\"fill\" data-input-arrow=\"down\"><label class=\"ds-input-field__label\" for=\"form-current-choice-input\">Lable</label><input class=\"ds-input-field__input ds-input-field__input--gray\" placeholder=\"Please enter text\" id=\"form-current-choice-input\" type=\"text\" name=\"choice\"><div class=\"ds-input-field__error\" id=\"form-current-choice-input-error\" hidden><span class=\"ds-input-field__error-icon\" aria-hidden=\"true\"></span><span class=\"ds-input-field__error-text\">Please check this value.</span></div></div></div>\n          <div class=\"ds-form__field\"><div class=\"ds-input-field\" data-input-current data-input-layout=\"fill\" data-input-arrow=\"down\"><label class=\"ds-input-field__label\" for=\"form-native-example-5\">Label</label><input class=\"ds-input-field__input ds-input-field__input--gray\" placeholder=\"Please enter text\" id=\"form-native-example-5\" type=\"text\" name=\"fieldFour\"><div class=\"ds-input-field__error\" id=\"form-native-example-5-error\" hidden><span class=\"ds-input-field__error-icon\" aria-hidden=\"true\"></span><span class=\"ds-input-field__error-text\">Please check this value.</span></div></div></div>\n        </div>\n        <div class=\"ds-form__field\">\n          <div class=\"ds-input-field\" data-input-current=\"\" data-input-layout=\"fill\" data-input-kind=\"textarea\">\n            <div class=\"ds-input-field__header\"><label class=\"ds-input-field__label\" for=\"form-native-example-6\">Comments</label><span class=\"ds-input-field__count\" id=\"form-current-comments-count\">0/5000</span></div>\n            <textarea class=\"ds-input-field__input ds-input-field__input--gray\" placeholder=\"Your comments will help FS respond more quickly.\" id=\"form-native-example-6\" name=\"comments\" maxlength=\"5000\" aria-describedby=\"form-current-comments-count\"></textarea>\n          </div>\n        </div>\n        <div class=\"ds-form__field\"><span class=\"ds-form__label\">How would you like us to contact you?</span>\n          <div class=\"ds-form__radio-group\">\n            <label class=\"ds-checkbox ds-checkbox--sm\" data-checkbox-current=\"\" data-checkbox-control=\"\"><input class=\"ds-checkbox__input\" type=\"checkbox\" checked=\"\" name=\"contactMethods\" value=\"email\"><span class=\"ds-checkbox__box\" aria-hidden=\"true\"></span><span class=\"ds-checkbox__label\">Email</span></label>\n            <label class=\"ds-checkbox ds-checkbox--sm\" data-checkbox-current=\"\" data-checkbox-control=\"\"><input class=\"ds-checkbox__input\" type=\"checkbox\" name=\"contactMethods\" value=\"phone\"><span class=\"ds-checkbox__box\" aria-hidden=\"true\"></span><span class=\"ds-checkbox__label\">Phone</span></label>\n          </div>\n        </div>\n        <label class=\"ds-form__consent\"><span class=\"ds-checkbox ds-checkbox--sm\" data-checkbox-current=\"\" data-checkbox-control=\"\"><input class=\"ds-checkbox__input\" type=\"checkbox\" name=\"consent\" value=\"agreed\"><span class=\"ds-checkbox__box\" aria-hidden=\"true\"></span></span><span class=\"ds-form__consent-copy\">I have read and agree to the FS.COM <a aria-disabled=\"true\" role=\"link\">Terms and Conditions</a> and acknowledge the <a aria-disabled=\"true\" role=\"link\">Privacy Policy and Notice at Collection</a>.</span></label>\n        <div><button class=\"ds-btn ds-btn--filled-red ds-btn--xl-regular\" type=\"submit\"><span class=\"ds-btn__text\">Submit</span></button></div>\n      </form>"
    }
  ],
