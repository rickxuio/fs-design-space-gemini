        "arrowHidden"
      ],
      "exampleHtml": "<a class=\"ds-text-btn ds-text-btn--inline ds-text-btn--black-bold ds-text-btn--l\" href=\"#\" data-ai-example=\"ai-text-button-inline-black-bold-l\">\n          <span class=\"ds-text-btn__text\">了解更多</span>\n          <img class=\"ds-text-btn__icon\" src=\"../icons/icon-text-button-arrow-right-bold.svg\" alt=\"\">\n        </a>"
