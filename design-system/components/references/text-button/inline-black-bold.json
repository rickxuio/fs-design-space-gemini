          "attribute": "href",
          "protocols": [
            "https:",
            "http:",
            "mailto:",
            "tel:"
          ],
          "relative": true,
          "previewPlaceholder": "#"
        },
        "arrowHidden": {
          "mode": "native-attribute",
          "target": "img.ds-text-btn__icon",
          "attribute": "hidden",
          "values": [
            false,
            true
          ],
          "default": false,
          "sourceProperty": "向右箭头",
          "sourceInverted": true
        }
      },
      "purpose": "navigation-inline-black-bold",
      "whenToUse": "来源明确为14px加粗文字入口，如首页特定卡片中的Get more Information、FS Certified",
      "whenNotToUse": "无加粗依据的普通链接，不凭“更重要”擅自加粗",
