{
  "schemaVersion": "fs-component-reference/1.0.0",
  "component": {
    "id": "option-selector",
    "name": "OptionSelector",
    "scope": "desktop-plain-h7-media-and-compact-SKU-price-product-radio-options-MG-Tag-PC-color-and-accessory",
    "reviewStatus": {
      "engineering": "pending",
      "visual": "pending",
      "familyCoverage": "partial"
    }
  },
  "selection": {
    "policy": "Use full plain H7 media or two-line detail product radio button. Every operational call needs the existing radiogroup wrapper with an accessible name and >=2 unique nonempty values; alone the specimen is presentation-only. 当前《新文件》仅核实Radio结算插槽边界；OptionSelector独立规范未定位，保留本地兼容范围，不标为全族MG通过。 颜色与服务已定位Tag常规属性/配件属性；颜色复用Select下拉，服务复用原生Checkbox。仅PC，不沿本地草案的Radio/24px图/M横向行。",
    "supported": [
      "media",
      "product",
      "color",
      "service"
    ],
    "unsupported": [
      "payment-brand",
      "plain-sm",
      "other-size-canonical-calls",
      "standalone-interaction",
      "initial-selected-canonical",
      "public-dynamic-api",
      "legacy-current-co-loading",
      "mobile"
    ]
  },
  "runtime": {
    "styles": [
      "components/tokens.css",
      "components/components.css",
      "components/checkbox-current.css",
      "components/option-selector-current.css",
      "components/tag-configuration-current.css",
      "components/select-current.css",
      "components/option-configuration-current.css"
    ],
    "scripts": [
