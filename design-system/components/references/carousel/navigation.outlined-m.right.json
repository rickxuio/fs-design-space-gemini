  "selection": {
    "policy": "先按MG外部多图/内部单图或多图/首页/主多图区分，再核尺寸、方向及准入。外部48排除详情与解决方案页；内部36/20未开放。Banner用户56与MG48冲突保留。四个方向原子不等于完整轮播，宿主管理定位、热区、切换和禁用。 普通外部内容多卡片已补external-cards：仅同一种普通竖向Card或IconCard，按items真实子调用，2/3/4列；禁止详情/解决方案、Banner、自动播放或混合类型。",
    "supported": [
      "navigation.outlined-m.left",
      "navigation.outlined-m.right",
      "navigation.solid-xl.left",
      "navigation.solid-xl.right",
      "external-cards"
    ],
    "unsupported": [
      "light",
      "dark",
      "unregistered-icon",
      "other-sizes",
      "homepage-autoplay",
      "detail-or-solution-carousel",
      "mixed-card-families",
      "arbitrary-html-items"
    ]
  },
