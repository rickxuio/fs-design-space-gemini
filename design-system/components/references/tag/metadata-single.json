{
  "schemaVersion": "fs-component-reference/1.0.0",
  "component": {
    "id": "tag",
    "name": "Tag",
    "scope": "existing-desktop-tag-finite-display-toggles-and-card-product-small",
    "reviewStatus": {
      "engineering": "pending",
      "visual": "pending",
      "familyCoverage": "partial"
    }
  },
  "selection": {
    "policy": "Use one finite authored example per supported family: two default marker-only button toggles, success 12px status, source-matched single metadata value or exactly two dual metadata values, fixed Individual neutral/info and fixed FEATURED/star. Not all colors, sizes, states or source/browser acceptance. 当前filter支持显式closeCallback，宿主移除；不自动移除业务对象。 2026-10-14按用户提供母组件补Card必要小号三种属性；原件产品图=false；颜色仅改data-tag-color的六位HEX选项内容，不开放任意CSS。 按relations.variantDecisions的具体场景选型；最终资格读同版catalog，未开放项不自动调用。当前MG核对状态见prototypeRollout，不将既有来源冒称本次在线核对。",
    "supported": [
      "selectable",
      "filter",
      "status-text",
      "metadata",
      "metadata-single",
      "semantic",
      "featured",
      "semantic-new",
      "product-regular-small",
      "product-custom-small",
      "product-color-small"
    ],
    "unsupported": [
      "select-removal-tag",
      "native-checkbox-submission",
      "mobile",
      "status-warning-or-large",
      "semantic-other-colors-or-iconless",
      "unrecorded-size-state-or-host-adaptation",
      "implicit-business-removal-without-host-callback",
      "product-configuration-color-source",
      "product-accessory-pc-source"
    ]
  },
  "runtime": {
    "styles": [
      "components/tokens.css",
      "components/components.css",
      "components/tag-current.css",
      "components/tag-product-current.css",
      "components/tag-configuration-current.css"
    ],
    "scripts": [
      "components/tag-current.js",
      "components/tag-product-current.js"
    ],
    "fontStylesheets": [
      "https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&display=swap"
    ],
    "fontFallback": "沿用Open Sans字体栈；远端字体不可用时回退。"
  },
  "identity": {
    "rule": "Default native button with data-tag-current, type=button and aria-pressed=false; current delegated runtime scopes standalone Tag toggles and excludes Select removal adapters. Static Tag examples are native spans; semantic/featured text and icon are frozen. No role/tabindex/button or toggle marker may be added.",
    "labelRule": "selectable保留唯一label；filter保留唯一prefix/value及原关闭图标。filter必须保留data-tag-close=event与键盘说明；X保持img，不嵌套button。",
    "product": "button.ds-tag--product-small[data-tag-product=current], type=button, default aria-pressed=false；文字唯一span.ds-tag__product-label，产品图=false；颜色唯一14px装饰chip及有效六位HEX内容/可访问名。Canonical forbids host action/state markers.",
    "metadata": "Single mother017293 uses ds-tag-meta--single/data-tag-source-metadata=single and one value; dual019949 uses source markerdual and two values withDivider. Both are static spans; no inferred interaction."
  },
  "locked": [
    "根button、类型、28px形态与共享CSS",
    "默认状态与aria-pressed",
    "filter关闭图标及前缀/值分组",
    "tag-current.js选择事件语义",
    "X只发关闭事件，宿主负责移除；不添加提交/通用业务删除",
    "Static span structure, default semantic class and decorative assets; semantic Individual and FEATURED labels are literal",
    "Product small22 frame, inside1px stroke and original variant state colours; image=false source Boolean",
    "Customized literal label; colour content edits only on data-tag-color, never frame CSS"
  ],
  "behavior": {
    "toggle": "点击button时切换ds-tag--checked，同步aria-pressed，派发冒泡ds:tag-change；detail.checked为布尔值。",
    "disabled": "原生disabled禁止响应；本批默认实例不开放disabled编辑。",
    "close": "用户2026-10-13最新决定：点击X删除已选择标签。当前filter X只派发可取消冒泡ds:tag-close/detail.checked，不切换checked、不派发tag-change；宿主closeCallback决定并移除。组件不会自行删除调用实例。聚焦filter后Delete/Backspace提供等效关闭；禁用/隐藏/Select移除适配不响应。",
    "programmatic": "首次初始化同步既有checked类；动态button点击由事件委托处理，但动态插入的初始aria需宿主提供一致状态。",
    "selectHost": "Current Tag excludes .ds-select / data-select-remove, avoiding accidental toggle events when mixed with select-current.js. This only resolves runtime interference; source/style adapter remains unapproved.",
    "initialization": "One document guard; marker-only delegated current calls, including dynamically inserted exact calls. Do not load legacy tag.js alongside current Tag runtime.",
    "display": "Static examples dispatch no Tag event and add no keyboard, link or form control semantics; only status label and two metadata texts are editable.",
    "product": "tag-product-current.js隔离原有Tag切换；常规/颜色切换aria-pressed并发ds:tag-change；Customized或Card已登记+N适配仅发ds:tag-activate，宿主决定动作。状态矩阵data-tag-state为来源展示，不响应切换。颜色初始化/动态插入/属性更新仅写内部色块background-color。"
  },
