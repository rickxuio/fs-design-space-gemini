{
  "schemaVersion": "fs-component-reference/1.0.0",
  "component": {
    "id": "pagination",
    "name": "Pagination",
    "scope": "desktop-pc-pagination-default",
    "reviewStatus": {
      "engineering": "pending",
      "visual": "pending",
