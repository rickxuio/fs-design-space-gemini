    }
  },
  "selection": {
    "policy": "用于 PLP 商品列表、搜索结果或评价列表页码切换；轮播圆点与章节锚点禁止套用。",
    "supported": [
      "default"
    ],
    "unsupported": [
      "jump-to-page-input",
      "page-size-selector",
      "mobile"
    ]
  },
  "runtime": {
    "styles": [
      "components/tokens.css",
      "components/pagination-current.css"
    ],
    "scripts": [
      "components/pagination.js"
    ]
  },
  "identity": {
    "rule": "保留 nav.ds-pagination[data-pagination-current=default] 根元素与 button.ds-pagination__btn 子节点，当前页带 ds-pagination__btn--active 与 aria-current=page。",
    "labelRule": "可访问名称默认 Pagination，支持通过 accessibleLabel 覆盖。"
  },
  "locked": [
    "nav.ds-pagination 根结构与 data-pagination-current=default",
    "32x32px 页码按钮与 4px 圆角、#F2F2F2 激活背景、#F6F6F8 悬停背景",
    "由 pagination.js 统一管理上一页/下一页禁用态、aria-current 与 ds:pagination-change 事件"
  ],
  "behavior": {
    "selection": "点击页码或上一页/下一页更新激活态并派发 ds:pagination-change 事件，由宿主页面响应数据翻页。",
    "scope": "当前仅提供标准页码条，不包含每页条数选择器和跳页输入框。"
  },
  "examples": [
    {
      "name": "default",
      "publication": {
        "key": "pagination/default",
        "disposition": "restricted",
        "newPages": true,
        "reason": "Standard PC list pagination bar for PLP, search, and review lists; dispatches ds:pagination-change.",
        "constraints": [
          "Standard PC list pagination bar for PLP, search, and review lists; do not use for carousel dots or section anchor nav."
        ],
        "contractPolicy": "用于 PLP 商品列表、搜索结果或评价列表页码切换；轮播圆点与章节锚点禁止套用。",
        "use": "finite-new-page-candidate",
        "evidence": "components/contracts/pagination.json#aiContract/evidence",
        "requiresCurrentEngineering": true,
        "visualApproval": "separate-not-granted"
      },
      "rootTag": "nav",
      "sizeOptions": [],
      "bindings": {
        "changeCallback": {
          "mode": "event-handler",
          "target": "root",
          "event": "ds:pagination-change"
        },
        "accessibleLabel": {
          "mode": "accessible-label",
          "target": "root",
          "attribute": "aria-label",
          "nonEmpty": true
        }
      },
      "purpose": "desktop-pc-list-pagination",
      "whenToUse": "PLP 商品列表页、搜索结果页或长评价列表需要页码翻页导航。",
      "whenNotToUse": "轮播指示点（请使用 Carousel）或章节锚点导航（请使用 AnchorNav）。",
      "rootClasses": "ds-pagination",
      "requiredStructure": [
        "button.ds-pagination__btn"
      ],
      "slots": {
        "items": {
          "selector": ":scope",
          "mode": "structured-content",
          "required": true,
          "preserve": [
            "button.ds-pagination__btn"
          ],
          "rule": "保留 button.ds-pagination__btn（含 data-page-nav prev/next 与 data-page-num）及可选 span.ds-pagination__ellipsis。"
        }
      },
      "allowedEdits": [
        "items",
        "changeCallback",
        "accessibleLabel"
      ],
      "exampleHtml": "<nav class=\"ds-pagination\" data-pagination-current=\"default\" aria-label=\"Pagination\" data-ai-example=\"ai-pagination-default\">\n        <button type=\"button\" class=\"ds-pagination__btn\" data-page-nav=\"prev\" disabled aria-label=\"Previous page\">&lsaquo;</button>\n        <button type=\"button\" class=\"ds-pagination__btn ds-pagination__btn--active\" data-page-num=\"1\" aria-current=\"page\">1</button>\n        <button type=\"button\" class=\"ds-pagination__btn\" data-page-num=\"2\">2</button>\n        <button type=\"button\" class=\"ds-pagination__btn\" data-page-num=\"3\">3</button>\n        <button type=\"button\" class=\"ds-pagination__btn\" data-page-num=\"4\">4</button>\n        <button type=\"button\" class=\"ds-pagination__btn\" data-page-num=\"5\">5</button>\n        <button type=\"button\" class=\"ds-pagination__btn\" data-page-num=\"6\">6</button>\n        <button type=\"button\" class=\"ds-pagination__btn\" data-page-nav=\"next\" aria-label=\"Next page\">&rsaquo;</button>\n      </nav>"
    }
  ],
