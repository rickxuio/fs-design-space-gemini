{
  "schemaVersion": "fs-component-reference/1.0.0",
  "component": {
    "id": "list",
    "name": "List",
    "scope": "seven-finite-PC-list-calls-and-source-locked-private-parts",
    "reviewStatus": {
      "engineering": "pending",
      "visual": "pending",
      "familyCoverage": "partial"
    }
  },
  "selection": {
    "policy": "按结构化数据、操作密集、商品内容、资料属性或信息流区分；属性键值PC已提供照片/认证/编辑意图，实际保存归宿主。12/14无序正文沿原获准来源；IconCard蓝色链接是限宿主私有覆盖，不是通用母组件变体。折叠详情仍缺实际源码，不借FAQ替代。",
    "supported": [
      "structured-data",
      "content-stream",
      "unordered-12",
      "unordered-14",
      "operation-intensive",
      "product-content",
      "attribute-key-value"
    ],
    "unsupported": [
      "collapsible-detail",
      "mobile",
      "localized-action-routing",
      "dynamic-insertion-api",
      "business-persistence"
    ]
  },
