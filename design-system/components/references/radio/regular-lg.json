{
  "schemaVersion": "fs-component-reference/1.0.0",
  "component": {
    "id": "radio",
    "name": "Radio",
    "scope": "existing-desktop-radio-four-default-native-options",
    "reviewStatus": {
      "engineering": "pending",
      "visual": "pending",
      "familyCoverage": "partial"
    }
  },
  "selection": {
    "policy": "普通文字互斥组至少2项；宽松用regular-lg、密集用regular-sm、紧凑描边用bordered-compact，bordered-detail只用于结算地址/账单/交货/支付共性框架。同组name相同、value唯一且至多一个checked；单项确认用Checkbox。结算品牌/价格/操作可为源稿插槽，当前精确调用只开放已登记主副文本，不冒充独立OptionSelector。",
    "supported": [
      "regular-lg",
      "regular-sm",
      "bordered-compact",
      "bordered-detail"
    ],
    "unsupported": [
      "single-option-confirmation",
      "media-option",
      "business-extra-slot",
      "indeterminate",
      "forced-hover-state",
      "mobile"
    ]
  },
  "runtime": {
    "styles": [
      "components/tokens.css",
      "components/components.css",
      "components/radio-current.css"
    ],
    "scripts": [],
    "fontStylesheets": [
      "https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&display=swap"
    ],
    "fontFallback": "沿用Open Sans字体栈；实际字体和浏览器视觉仍待验证。"
  },
  "identity": {
    "rule": "原生label包含唯一radio input，无需虚构ID或额外JS。同一互斥组至少两项共享非空name且value唯一，不同业务组更换name；每组最多一个checked。",
    "labelRule": "保留图标在前、文字在后；detail必须保留主副文字结构。",
    "currentDetail": "bordered-detail必须data-radio-current=detail-framework并加载radio-current.css；历史无标记实例不升级。",
    "currentDefault14": "三个14px有限调用必须data-radio-source-default14=official；仅未选中、可用、非Hover的Default使用14px原件透明环，不跨尺寸使用。",
    "currentDefault18": "regular-lg必须data-radio-source-default18=official；仅未选中、可用、非Hover的Default使用18px原件透明环，历史无标记实例不升级。",
    "currentHover": "沿用各尺寸data-radio-source-default14/18=official来源标记；未选中且可用的真实/强制Hover使用对应当前Hover透明环，不改变checked/disabled或历史资源。",
    "currentPress": "沿用各尺寸data-radio-source-default14/18=official来源标记；可用checked使用当前Press灰环/圆点原件，Hover不改变，disabled和历史资源不升级。",
    "currentDisabled": "各尺寸既有来源标记的disabled使用对应未选/选中原件，颜色已包含30%；未选保留Gray8底色，选中保留透明间隙。标签样式与原生禁用行为不变，历史不升级。"
  },
  "locked": [
    "label > radio input + indicator + content",
    "准确根变体、图标和CSS",
    "原生radio语义与组互斥",
    "内容层级与detail说明",
    "不添加自写状态JS或内联绘图",
    "14px Default当前资源标记与透明环资产",
    "18px Default当前资源标记与透明环资产",
    "14/18px当前Hover透明环资产及checked/disabled隔离",
    "14/18px当前Press原件及Disabled选中隔离",
    "14/18px当前两种Disabled原件及历史边界"
  ],
  "behavior": {
    "native": "使用原生radio及change事件；checked/disabled为原生布尔属性，CSS由原生状态决定。",
    "groups": "同一表单或文档作用域内，相同name由浏览器互斥；独立业务组必须不同name，同组value不能重复。",
    "keyboard": "键盘与焦点使用浏览器原生行为；本轮模拟DOM没有验证实际键盘、焦点环或几何。",
    "content": "detail仅替换主副文字，本批不开放业务extra区域。",
    "assembly": "精确清单提供单项结构，不能把单项示例当成完整组验收；最终组数量/命名/初始checked仍需装配检查。"
  },
  "examples": [
    {
      "name": "regular-lg",
      "publication": {
        "key": "radio/regular-lg",
        "disposition": "retain",
        "newPages": true,
        "reason": "Retain existing finite exact contract only.",
        "constraints": [
          "Regular native labels/groups; compact is14px indicator/30px shape; checkout detail withheld."
        ],
        "contractPolicy": "regular-lg为宽松普通文字、regular-sm为密集文字、bordered-compact为紧凑描边、bordered-detail仅为结算主副文字；使用各自完整默认label实例。同组至少2项，不套用媒体/价格选择内容。",
        "use": "finite-new-page-candidate",
        "evidence": "components/contracts/radio.json#aiContract/evidence",
        "requiresCurrentEngineering": true,
        "visualApproval": "separate-not-granted"
      },
      "rootTag": "label",
      "sizeOptions": [],
      "bindings": {
        "name": {
          "mode": "native-attribute",
          "target": "input.ds-radio__input",
          "attribute": "name",
          "valueType": "nonempty-string"
        },
        "value": {
          "mode": "native-attribute",
          "target": "input.ds-radio__input",
          "attribute": "value",
          "valueType": "nonempty-string"
        },
        "checked": {
          "mode": "native-attribute",
          "target": "input.ds-radio__input",
          "attribute": "checked",
          "values": [
            false,
            true
          ],
          "default": false
        },
        "disabled": {
          "mode": "native-attribute",
          "target": "input.ds-radio__input",
          "attribute": "disabled",
          "values": [
            false,
            true
          ],
          "default": false
        },
        "changeCallback": {
          "mode": "event-handler",
          "target": "root",
          "event": "change"
        }
      },
      "purpose": "native-radio-regular-lg",
      "whenToUse": "同组≥2；商品详情页解决方案产品筛选等 PC 宽松区域；18×18px 状态图与 14px/22px 标签。",
      "whenNotToUse": "下拉、表单等密集区域使用 regular-sm；需要容器时使用对应带边框变体。",
      "rootClasses": "ds-radio",
      "requiredStructure": [
        "input.ds-radio__input",
        "span.ds-radio__indicator",
        "span.ds-radio__content",
        "span.ds-radio__label"
      ],
      "slots": {
        "label": {
          "selector": "span.ds-radio__label",
          "mode": "text",
          "required": true
        }
      },
      "allowedEdits": [
        "label",
        "name",
        "value",
        "checked",
        "disabled",
        "changeCallback"
      ],
      "exampleHtml": "<label class=\"ds-radio\" data-radio-source-default18=\"official\" data-ai-example=\"ai-radio-regular-lg\"><input class=\"ds-radio__input\" type=\"radio\" name=\"lg-default\" value=\"a\"><span class=\"ds-radio__indicator\" aria-hidden=\"true\"></span><span class=\"ds-radio__content\"><span class=\"ds-radio__label\">Options-A</span></span></label>"
    }
  ],
